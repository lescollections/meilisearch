# Réglages du harnais. Tout a un défaut dans compose.yml : ce fichier ne sert qu'à en changer.
# Copier en `dev/.env` (ignoré par git) si besoin.
#
#   cp .env.example .env

# Le port sur lequel l'instance écoute sur ta machine. 8089 pour ne pas heurter le harnais du
# greffon lescollections, qui occupe 8088.
#CA_HOST_PORT=8089

# Connexion à l'UI. Rien de sensible : la base est jetable et n'écoute que sur ta machine.
#CA_ADMIN_USER=administrator
#CA_ADMIN_PASSWORD=collections
#CA_ADMIN_EMAIL=dev@meilisearch.test

# Le profil d'installation de CollectiveAccess (install/profiles/xml/<nom>.xml du fork).
#CA_PROFILE=default

# Identifiants MariaDB.
#CA_DB_DATABASE=collectiveaccess
#CA_DB_USER=collectiveaccess
#CA_DB_PASSWORD=collectiveaccess
#CA_DB_ROOT_PASSWORD=root

# ── Meilisearch ───────────────────────────────────────────────────────────────────────────

#MEILISEARCH_VERSION=v1.13
#MEILISEARCH_HOST_PORT=7700
#MEILISEARCH_LOG_LEVEL=INFO

# Adresse du service, vue depuis le conteneur applicatif.
#CA_MEILISEARCH_URL=http://meilisearch:7700

# Clé maîtresse. Vide, Meilisearch tourne sans authentification. La renseigner pour éprouver
# le chemin authentifié : elle est passée au service *et* au connecteur.
#CA_MEILISEARCH_API_KEY=

# Préfixe des noms d'index (<préfixe>_ca_objects, …). En changer permet de faire cohabiter
# plusieurs instances sur un même service.
#CA_MEILISEARCH_INDEX_PREFIX=ca

# ── Le corpus ─────────────────────────────────────────────────────────────────────────────

# Mettre à 0 pour ne pas installer / semer automatiquement au premier démarrage.
#CA_AUTO_INSTALL=1

# Le jeu d'exemple cleveland de rochambeau. 2500 objets, le corpus complet : 250 ne disent
# rien du comportement d'un moteur de recherche.
#CA_SEED_CLEVELAND=1
#CA_SEED_CLEVELAND_COUNT=2500

# Les images. À 1, compter une bonne demi-heure de plus au premier démarrage et un accès
# réseau : chaque image est téléchargée et ses dérivés fabriqués. Elles n'apprennent rien sur
# un moteur de recherche.
#CA_SEED_CLEVELAND_MEDIA=0

# Niveau d'accès du corpus semé. 1 (public) par défaut : à 0, les filtres d'accès de
# CollectiveAccess écarteraient tout le corpus des résultats.
#CA_SEED_ACCESS=1
