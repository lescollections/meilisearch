{"parentUuid":"ac2fce02-d6bf-4972-808d-691dd4c68064","isSidechain":true,"agentId":"aa6cd2aa148ac9212","message":{"model":"claude-opus-5","id":"msg_011CeBxBTAELKq2okrpdTyKj","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me read the two untracked files in full."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16158,"cache_read_input_tokens":15325,"cache_creation":{"ephemeral_5m_input_tokens":16158,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null},"requestId":"req_011CeBxBSMrkfJuWdKnkCbhD","attributionAgent":"Explore","type":"assistant","uuid":"deb348df-153f-4187-87e1-ad8389a47ee2","timestamp":"2026-08-19T10:30:33.256Z","effort":"high","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/gautier/git/lescollections/meilisearch","sessionId":"8f9b4c71-76ba-45d0-a77c-f69b92544b91","version":"2.1.235","gitBranch":"main"}
{"parentUuid":"deb348df-153f-4187-87e1-ad8389a47ee2","isSidechain":true,"agentId":"aa6cd2aa148ac9212","message":{"model":"claude-opus-5","id":"msg_011CeBxBTAELKq2okrpdTyKj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ja7CLZXr5BqjSwMcpfGMN6","name":"Read","input":{"file_path":"/Users/gautier/git/lescollections/meilisearch/MeilisearchSearchEngine/Facets.php"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16158,"cache_read_input_tokens":15325,"output_tokens":177,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":16158},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":177,"cache_read_input_tokens":15325,"cache_creation_input_tokens":16158,"cache_creation":{"ephemeral_5m_input_tokens":16158,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeBxBSMrkfJuWdKnkCbhD","attributionAgent":"Explore","type":"assistant","uuid":"de3f78a3-4943-4bac-850b-b4cfa41ac9f0","timestamp":"2026-08-19T10:30:34.071Z","effort":"high","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/gautier/git/lescollections/meilisearch","sessionId":"8f9b4c71-76ba-45d0-a77c-f69b92544b91","version":"2.1.235","gitBranch":"main"}
{"parentUuid":"de3f78a3-4943-4bac-850b-b4cfa41ac9f0","isSidechain":true,"agentId":"aa6cd2aa148ac9212","message":{"model":"claude-opus-5","id":"msg_011CeBxBTAELKq2okrpdTyKj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B4VFUeVhXkViLMVcEobo5R","name":"Read","input":{"file_path":"/Users/gautier/git/lescollections/meilisearch/tests/browse-facettes.php"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16158,"cache_read_input_tokens":15325,"output_tokens":177,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":16158},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":177,"cache_read_input_tokens":15325,"cache_creation_input_tokens":16158,"cache_creation":{"ephemeral_5m_input_tokens":16158,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CeBxBSMrkfJuWdKnkCbhD","attributionAgent":"Explore","type":"assistant","uuid":"1bec2cb3-28be-4eec-8378-109b6b512bef","timestamp":"2026-08-19T10:30:34.076Z","effort":"high","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/gautier/git/lescollections/meilisearch","sessionId":"8f9b4c71-76ba-45d0-a77c-f69b92544b91","version":"2.1.235","gitBranch":"main"}
{"parentUuid":"1bec2cb3-28be-4eec-8378-109b6b512bef","isSidechain":true,"promptId":"5459b1ec-9358-4e86-9ad4-5a94fd6ff28b","agentId":"aa6cd2aa148ac9212","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B4VFUeVhXkViLMVcEobo5R","type":"tool_result","content":"1\t<?php\n2\t/* ----------------------------------------------------------------------\n3\t * tests/browse-facettes.php — équivalence des facettes SQL et Meilisearch.\n4\t *\n5\t * Le pont des facettes (MeilisearchSearchEngine/Facets.php) promet de rendre exactement ce\n6\t * que le SQL du BrowseEngine aurait rendu, ou de décliner. Ce test tient la promesse contre\n7\t * l'instance réelle : pour chaque scénario, la facette est calculée deux fois — une fois par\n8\t * le SQL du socle (délégation désactivée par réflexion), une fois par le pont (appel direct,\n9\t * un déclin y est un échec) — et les deux résultats doivent porter les mêmes identifiants et\n10\t * les mêmes comptes.\n11\t *\n12\t * Écart toléré, et lui seul : le compte d'un nœud non-feuille d'une facette hiérarchique. Le\n13\t * SQL additionne les comptes des descendants (un objet lié à deux descendants compte deux\n14\t * fois) ; le moteur compte les documents distincts. Le compte du moteur est le bon.\n15\t *\n16\t * Le patch du socle (délégation dans BrowseEngine::getFacetContent) et une réindexation\n17\t * complète sont des préalables : sans eux, tout décline et le test échoue franchement.\n18\t * ---------------------------------------------------------------------- */\n19\t\n20\trequire_once(__DIR__ . '/_cadre.php');\n21\trequire_once(__CA_APP_DIR__ . '/helpers/browseHelpers.php');\n22\t\n23\t$plugin = SearchBase::newSearchEngine();\n24\t\n25\tverifier('le moteur configuré expose getBrowseFacetContent()', function () use ($plugin) {\n26\t\test_vrai(is_object($plugin), 'aucun moteur de recherche chargé');\n27\t\test_vrai(method_exists($plugin, 'getBrowseFacetContent'), get_class($plugin) . ' ne porte pas la méthode');\n28\t});\n29\t\n30\tverifier('le socle porte le point de délégation', function () {\n31\t\test_vrai(property_exists('BrowseEngine', 's_facet_engine'),\n32\t\t\t'BrowseEngine::$s_facet_engine absent — le patch du socle n\\'est pas appliqué');\n33\t});\n34\t\n35\t# ----------------------------------------------------------------------\n36\t# Outillage\n37\t# ----------------------------------------------------------------------\n38\t\n39\t/** Force ou libère la délégation dans le socle. false = SQL pur, null = re-résolution. */\n40\tfunction delegation($valeur): void {\n41\t\t$p = new ReflectionProperty('BrowseEngine', 's_facet_engine');\n42\t\t$p->setAccessible(true);\n43\t\t$p->setValue(null, $valeur);\n44\t}\n45\t\n46\t/** Un browse neuf porteur des critères donnés, exécuté si nécessaire. */\n47\tfunction browse_avec(array $criteres, array $options = []): BrowseEngine {\n48\t\t$b = caGetBrowseInstance('ca_objects');\n49\t\tforeach ($criteres as $facette => $valeurs) {\n50\t\t\t$b->addCriteria($facette, is_array($valeurs) ? $valeurs : [$valeurs]);\n51\t\t}\n52\t\tif (sizeof($criteres)) {\n53\t\t\t// Le SQL restreint les facettes au résultat courant : il faut qu'il existe.\n54\t\t\t$b->execute(array_merge(['dontCheckFacetAvailability' => true], $options));\n55\t\t}\n56\t\treturn $b;\n57\t}\n58\t\n59\t/** La facette par le SQL du socle, délégation coupée. Rend un booléen en checkAvailabilityOnly. */\n60\tfunction facette_sql(string $facette, array $criteres = [], array $options = []) {\n61\t\tdelegation(false);\n62\t\ttry {\n63\t\t\treturn browse_avec($criteres, $options)->getFacetContent($facette, $options);\n64\t\t} finally {\n65\t\t\tdelegation(null);\n66\t\t}\n67\t}\n68\t\n69\t/** La facette par le pont, en appel direct — un déclin rend null et se voit. */\n70\tfunction facette_moteur($plugin, string $facette, array $criteres = [], array $options = []) {\n71\t\tdelegation(false);   // l'execute() du browse ne doit pas passer par le pont non plus\n72\t\ttry {\n73\t\t\t$b = browse_avec($criteres, $options);\n74\t\t\t$info = $b->getInfoForFacet($facette);\n75\t\t\test_vrai(is_array($info), \"facette « {$facette} » inconnue de browse.conf\");\n76\t\t\treturn $plugin->getBrowseFacetContent($b, $facette, $info, $options);\n77\t\t} finally {\n78\t\t\tdelegation(null);\n79\t\t}\n80\t}\n81\t\n82\t/** Réduit un contenu de facette à [id => compte], pour comparaison. */\n83\tfunction comptes(?array $contenu): array {\n84\t\t$out = [];\n85\t\tforeach (($contenu ?? []) as $cle => $poste) {\n86\t\t\t$out[(string)($poste['id'] ?? $cle)] = (int)($poste['content_count'] ?? -1);\n87\t\t}\n88\t\tksort($out, SORT_STRING);\n89\t\treturn $out;\n90\t}\n91\t\n92\t/**\n93\t * Les deux contenus portent les mêmes identifiants ; les comptes sont égaux, sauf tolérance\n94\t * sur les nœuds non-feuilles (child_count > 0 côté moteur) des facettes hiérarchiques.\n95\t */\n96\tfunction memes_facettes(?array $sql, $moteur, string $detail, bool $tolerer_branches = false): void {\n97\t\test_vrai($moteur !== null, \"{$detail} — le pont a décliné\");\n98\t\test_vrai(is_array($moteur), \"{$detail} — le pont n'a pas rendu de tableau\");\n99\t\n100\t\t$c_sql    = comptes($sql);\n101\t\t$c_moteur = comptes($moteur);\n102\t\n103\t\t$absents = array_diff(array_keys($c_sql), array_keys($c_moteur));\n104\t\t$en_trop = array_diff(array_keys($c_moteur), array_keys($c_sql));\n105\t\test_vrai(!sizeof($absents) && !sizeof($en_trop), sprintf(\n106\t\t\t'%s — identifiants divergents : %d absents du moteur (%s), %d en trop (%s)',\n107\t\t\t$detail, sizeof($absents), join(',', array_slice($absents, 0, 5)),\n108\t\t\tsizeof($en_trop), join(',', array_slice($en_trop, 0, 5))\n109\t\t));\n110\t\n111\t\tforeach ($c_sql as $id => $compte_sql) {\n112\t\t\tif ($tolerer_branches && (int)($moteur[$id]['child_count'] ?? 0) > 0) { continue; }\n113\t\t\test_egal($compte_sql, $c_moteur[$id], \"{$detail} — compte de {$id}\");\n114\t\t}\n115\t}\n116\t\n117\t# ----------------------------------------------------------------------\n118\t# Matière authority : le harnais n'a aucun lien objet-entité ni objet-terme,\n119\t# le test fabrique donc les siens — une fois, idempotent, marqués TEST-FAC.\n120\t#\n121\t# La hiérarchie de vocabulaire est le cas qui compte : « Abyssinie » porte deux\n122\t# enfants, et deux objets sont liés aux deux enfants à la fois — c'est là que le\n123\t# compte SQL d'un ancêtre (somme des descendants) et celui du moteur (documents\n124\t# distincts) divergent légitimement.\n125\t# ----------------------------------------------------------------------\n126\t\n127\tfunction fabriquer_matiere_authority($plugin): array {\n128\t\t$locale_id = ca_locales::getDefaultCataloguingLocaleID();\n129\t\t$db        = new Db();\n130\t\n131\t\t$qr = $db->query(\"SELECT object_id FROM ca_objects WHERE deleted = 0 ORDER BY object_id LIMIT 10\");\n132\t\t$objets = array_map('intval', $qr->getAllFieldValues('object_id'));\n133\t\test_vrai(sizeof($objets) === 10, 'moins de dix objets dans le fonds');\n134\t\n135\t\t$rt = new ca_relationship_types();\n136\t\t$type_rel = function (string $table) use ($rt): string {\n137\t\t\tforeach (($rt->getRelationshipInfo($table) ?: []) as $info) {\n138\t\t\t\t$code = $info['type_code'] ?? '';\n139\t\t\t\tif (strlen($code) && strpos($code, 'root_for') !== 0) { return $code; }\n140\t\t\t}\n141\t\t\tthrow new EchecAssertion(\"aucun type de relation utilisable pour {$table}\");\n142\t\t};\n143\t\n144\t\t// Deux entités : E1 sur 5 objets, E2 sur 3, le premier objet portant les deux.\n145\t\t$entites = [];\n146\t\tforeach ([['TEST-FAC-E1', 'Testeur', 'Abebe'], ['TEST-FAC-E2', 'Testeuse', 'Marta']] as $def) {\n147\t\t\tlist($idno, $nom, $prenom) = $def;\n148\t\t\t$id = ca_entities::find(['idno' => $idno], ['returnAs' => 'firstId']);\n149\t\t\tif (!$id) {\n150\t\t\t\t$t = new ca_entities();\n151\t\t\t\t$types = $t->getTypeList();\n152\t\t\t\t$t->set('type_id', array_key_first($types));\n153\t\t\t\t$t->set('idno', $idno);\n154\t\t\t\t$t->set('access', 1);\n155\t\t\t\t$t->insert();\n156\t\t\t\test_vrai(!$t->numErrors(), \"création {$idno} : \" . join('; ', $t->getErrors()));\n157\t\t\t\t$t->addLabel(['surname' => $nom, 'forename' => $prenom, 'displayname' => \"{$prenom} {$nom}\"], $locale_id, null, true);\n158\t\t\t\t$id = (int)$t->getPrimaryKey();\n159\t\t\t}\n160\t\t\t$entites[$idno] = (int)$id;\n161\t\t}\n162\t\n163\t\t// Un vocabulaire hiérarchique : Abyssinie > { Addis-Abeba, Harar }.\n164\t\t$list_id = (int)($db->query(\"SELECT list_id FROM ca_lists WHERE list_code = 'test_facettes_vocab'\")->getAllFieldValues('list_id')[0] ?? 0);\n165\t\tif (!$list_id) {\n166\t\t\t$t_list = new ca_lists();\n167\t\t\t$t_list->set('list_code', 'test_facettes_vocab');\n168\t\t\t$t_list->set('is_hierarchical', 1);\n169\t\t\t$t_list->set('is_system_list', 0);\n170\t\t\t$t_list->set('use_as_vocabulary', 1);\n171\t\t\t$t_list->insert();\n172\t\t\test_vrai(!$t_list->numErrors(), 'création de la liste : ' . join('; ', $t_list->getErrors()));\n173\t\t\t$t_list->addLabel(['name' => 'Vocabulaire de test des facettes'], $locale_id, null, true);\n174\t\t\t$list_id = (int)$t_list->getPrimaryKey();\n175\t\t}\n176\t\n177\t\t$racine = (int)($db->query(\"SELECT item_id FROM ca_list_items WHERE list_id = ? AND parent_id IS NULL\", [$list_id])->getAllFieldValues('item_id')[0] ?? 0);\n178\t\test_vrai($racine > 0, 'liste de test sans racine');\n179\t\n180\t\t$terme = function (string $idno, string $libelle, int $parent_id) use ($db, $list_id, $locale_id): int {\n181\t\t\t$id = (int)($db->query(\"SELECT item_id FROM ca_list_items WHERE list_id = ? AND idno = ?\", [$list_id, $idno])->getAllFieldValues('item_id')[0] ?? 0);\n182\t\t\tif ($id) { return $id; }\n183\t\t\t$t = new ca_list_items();\n184\t\t\t$t->set('list_id', $list_id);\n185\t\t\t$t->set('parent_id', $parent_id);\n186\t\t\t$t->set('idno', $idno);\n187\t\t\t$t->set('item_value', $idno);\n188\t\t\t$t->set('access', 1);\n189\t\t\t$t->set('is_enabled', 1);\n190\t\t\t$t->insert();\n191\t\t\test_vrai(!$t->numErrors(), \"création du terme {$idno} : \" . join('; ', $t->getErrors()));\n192\t\t\t$t->addLabel(['name_singular' => $libelle, 'name_plural' => $libelle], $locale_id, null, true);\n193\t\t\treturn (int)$t->getPrimaryKey();\n194\t\t};\n195\t\n196\t\t$abyssinie = $terme('TEST-FAC-ABYSSINIE', 'Abyssinie (test)', $racine);\n197\t\t$addis     = $terme('TEST-FAC-ADDIS', 'Addis-Abeba (test)', $abyssinie);\n198\t\t$harar     = $terme('TEST-FAC-HARAR', 'Harar (test)', $abyssinie);\n199\t\n200\t\t// Le socle n'affiche un ancêtre que s'il porte un type : on en pose un si le modèle en\n201\t\t// offre, et les attentes du test s'ajustent à sa présence. Le type d'un terme ne passe\n202\t\t// pas dans l'index — pas de réindexation à prévoir.\n203\t\t$types_de_termes = (new ca_list_items())->getTypeList();\n204\t\t$termes_types = is_array($types_de_termes) && sizeof($types_de_termes);\n205\t\tif ($termes_types) {\n206\t\t\t$db->query(\"UPDATE ca_list_items SET type_id = ? WHERE idno LIKE 'TEST-FAC-%' AND type_id IS NULL\",\n207\t\t\t\t[(int)array_key_first($types_de_termes)]);\n208\t\t}\n209\t\n210\t\t// Les liens : posés une fois — la présence du premier suffit à dire que tout y est.\n211\t\t$deja = (int)($db->query(\"SELECT COUNT(*) c FROM ca_objects_x_entities WHERE entity_id = ?\", [$entites['TEST-FAC-E1']])->getAllFieldValues('c')[0] ?? 0);\n212\t\tif (!$deja) {\n213\t\t\t$code_entite = $type_rel('ca_objects_x_entities');\n214\t\t\t$code_terme  = $type_rel('ca_objects_x_vocabulary_terms');\n215\t\n216\t\t\t$lier = function (int $object_id, string $table, int $rel_id, string $code) {\n217\t\t\t\t$t = new ca_objects($object_id);\n218\t\t\t\t$t->addRelationship($table, $rel_id, $code);\n219\t\t\t\test_vrai(!$t->numErrors(), \"lien {$object_id} → {$table}#{$rel_id} : \" . join('; ', $t->getErrors()));\n220\t\t\t};\n221\t\n222\t\t\tforeach (array_slice($objets, 0, 5) as $oid) { $lier($oid, 'ca_entities', $entites['TEST-FAC-E1'], $code_entite); }\n223\t\t\tforeach (array_slice($objets, 0, 3) as $oid) { $lier($oid, 'ca_entities', $entites['TEST-FAC-E2'], $code_entite); }\n224\t\n225\t\t\tforeach (array_slice($objets, 0, 6) as $oid) { $lier($oid, 'ca_list_items', $addis, $code_terme); }\n226\t\t\tforeach (array_slice($objets, 4, 4) as $oid) { $lier($oid, 'ca_list_items', $harar, $code_terme); }\n227\t\t\t// objets 5 et 6 (indices 4-5) sont liés aux deux enfants : le cas du double compte.\n228\t\n229\t\t\t// Réindexation ciblée des objets touchés, par le chemin de l'outil du greffon.\n230\t\t\trequire_once(__CA_APP_DIR__ . '/plugins/Meilisearch/tools/_socle.php');\n231\t\t\t$indexeur   = new SearchIndexer($db);\n232\t\t\t$table_num  = Datamodel::getTableNum('ca_objects');\n233\t\t\t$field_data = donnees_de_champs($indexeur, 'ca_objects', $objets, $db);\n234\t\t\tforeach ($objets as $oid) {\n235\t\t\t\t$indexeur->indexRow($table_num, $oid, $field_data[$oid] ?? [], true);\n236\t\t\t}\n237\t\t\t$plugin->flushContentBuffer();\n238\t\t}\n239\t\n240\t\treturn ['entites' => $entites, 'abyssinie' => $abyssinie, 'addis' => $addis, 'harar' => $harar,\n241\t\t\t'objets' => $objets, 'termes_types' => (bool)$termes_types];\n242\t}\n243\t\n244\t$matiere = fabriquer_matiere_authority($plugin);\n245\t\n246\t# ----------------------------------------------------------------------\n247\t# Matière : un type, une entité, tirés du fonds\n248\t# ----------------------------------------------------------------------\n249\t\n250\t$contenu_types = facette_sql('type_facet');\n251\test_vrai(is_array($contenu_types) && sizeof($contenu_types), 'le fonds n\\'offre aucun type d\\'objet — corpus non chargé ?');\n252\t$un_type = (string)array_key_first($contenu_types);\n253\t\n254\t// Le socle réindexe parfois ses postes séquentiellement : l'identifiant se lit dans le poste.\n255\t$contenu_entites = facette_sql('entity_facet');\n256\t$premier_poste = is_array($contenu_entites) && sizeof($contenu_entites) ? reset($contenu_entites) : null;\n257\t$une_entite = $premier_poste ? (string)$premier_poste['id'] : null;\n258\t\n259\t# ----------------------------------------------------------------------\n260\t# Équivalences, du simple au combiné\n261\t# ----------------------------------------------------------------------\n262\t\n263\tverifier('type_facet, fonds entier', function () use ($plugin) {\n264\t\tmemes_facettes(facette_sql('type_facet'), facette_moteur($plugin, 'type_facet'), 'type_facet');\n265\t});\n266\t\n267\tverifier('has_media_facet, fonds entier', function () use ($plugin) {\n268\t\tmemes_facettes(facette_sql('has_media_facet'), facette_moteur($plugin, 'has_media_facet'), 'has_media_facet');\n269\t});\n270\t\n271\tverifier('entity_facet, fonds entier', function () use ($plugin) {\n272\t\tmemes_facettes(facette_sql('entity_facet'), facette_moteur($plugin, 'entity_facet'), 'entity_facet');\n273\t});\n274\t\n275\tverifier('term_facet, fonds entier (hiérarchique : branches tolérées)', function () use ($plugin) {\n276\t\tmemes_facettes(facette_sql('term_facet'), facette_moteur($plugin, 'term_facet'), 'term_facet', true);\n277\t});\n278\t\n279\tverifier('entity_facet restreinte par un critère type_facet', function () use ($plugin, $un_type) {\n280\t\t$criteres = ['type_facet' => [$un_type]];\n281\t\tmemes_facettes(facette_sql('entity_facet', $criteres), facette_moteur($plugin, 'entity_facet', $criteres),\n282\t\t\t\"entity_facet sous type {$un_type}\");\n283\t});\n284\t\n285\tverifier('type_facet restreinte par un critère entity_facet', function () use ($plugin, $une_entite) {\n286\t\tif ($une_entite === null) { throw new EchecAssertion('aucune entité liée dans le fonds'); }\n287\t\t$criteres = ['entity_facet' => [$une_entite]];\n288\t\tmemes_facettes(facette_sql('type_facet', $criteres), facette_moteur($plugin, 'type_facet', $criteres),\n289\t\t\t\"type_facet sous entité {$une_entite}\");\n290\t});\n291\t\n292\tverifier('has_media_facet sous une recherche texte simple', function () use ($plugin) {\n293\t\t$criteres = ['_search' => ['oil']];\n294\t\tmemes_facettes(facette_sql('has_media_facet', $criteres), facette_moteur($plugin, 'has_media_facet', $criteres),\n295\t\t\t'has_media_facet sous « oil »');\n296\t});\n297\t\n298\tverifier('type_facet avec filtre d\\'accès', function () use ($plugin) {\n299\t\t$options = ['checkAccess' => [1]];\n300\t\tmemes_facettes(facette_sql('type_facet', [], $options), facette_moteur($plugin, 'type_facet', [], $options),\n301\t\t\t'type_facet, access=1');\n302\t});\n303\t\n304\tverifier('type_facet sous critères combinés (type + recherche)', function () use ($plugin, $un_type) {\n305\t\t$criteres = ['type_facet' => [$un_type], '_search' => ['painting']];\n306\t\tmemes_facettes(facette_sql('entity_facet', $criteres), facette_moteur($plugin, 'entity_facet', $criteres),\n307\t\t\t\"entity_facet sous type {$un_type} et « painting »\");\n308\t});\n309\t\n310\t# ----------------------------------------------------------------------\n311\t# Hiérarchies : le cas Abyssinie\n312\t# ----------------------------------------------------------------------\n313\t\n314\tverifier('term_facet : les feuilles portent les mêmes comptes, l\\'ancêtre suit la règle du socle', function () use ($plugin, $matiere) {\n315\t\t$sql    = facette_sql('term_facet');\n316\t\t$moteur = facette_moteur($plugin, 'term_facet');\n317\t\tmemes_facettes($sql, $moteur, 'term_facet', true);\n318\t\n319\t\t$m = comptes($moteur);\n320\t\test_egal(6, $m[(string)$matiere['addis']] ?? -1, 'Addis-Abeba (moteur)');\n321\t\test_egal(4, $m[(string)$matiere['harar']] ?? -1, 'Harar (moteur)');\n322\t\n323\t\tif ($matiere['termes_types']) {\n324\t\t\t// L'ancêtre : 6 + 4 liens, mais 8 objets distincts — le moteur compte les documents,\n325\t\t\t// le SQL additionne les branches. Les deux présences sont exigées, chacune à sa valeur.\n326\t\t\t$s = comptes($sql);\n327\t\t\test_egal(8,  $m[(string)$matiere['abyssinie']] ?? -1, 'Abyssinie (moteur, documents distincts)');\n328\t\t\test_egal(10, $s[(string)$matiere['abyssinie']] ?? -1, 'Abyssinie (SQL, somme des branches)');\n329\t\t} else {\n330\t\t\t// Sans type d'item, le socle écarte l'ancêtre — le pont doit l'écarter à l'identique.\n331\t\t\test_vrai(!isset($m[(string)$matiere['abyssinie']]), 'Abyssinie devrait être absente (ancêtre sans type)');\n332\t\t}\n333\t});\n334\t\n335\tverifier('un critère posé sur l\\'ancêtre restreint comme sa descendance, des deux côtés', function () use ($plugin, $matiere) {\n336\t\t$criteres = ['term_facet' => [(string)$matiere['abyssinie']]];\n337\t\tmemes_facettes(facette_sql('type_facet', $criteres), facette_moteur($plugin, 'type_facet', $criteres),\n338\t\t\t'type_facet sous Abyssinie');\n339\t\tmemes_facettes(facette_sql('entity_facet', $criteres), facette_moteur($plugin, 'entity_facet', $criteres),\n340\t\t\t'entity_facet sous Abyssinie');\n341\t});\n342\t\n343\tverifier('entity_facet porte la matière fabriquée, à comptes exacts', function () use ($plugin, $matiere) {\n344\t\t$moteur = facette_moteur($plugin, 'entity_facet');\n345\t\test_egal(5, (int)($moteur[$matiere['entites']['TEST-FAC-E1']]['content_count'] ?? -1), 'E1');\n346\t\test_egal(3, (int)($moteur[$matiere['entites']['TEST-FAC-E2']]['content_count'] ?? -1), 'E2');\n347\t});\n348\t\n349\t# ----------------------------------------------------------------------\n350\t# Modes et règles annexes\n351\t# ----------------------------------------------------------------------\n352\t\n353\tverifier('checkAvailabilityOnly rend le même verdict', function () use ($plugin) {\n354\t\tforeach (['type_facet', 'has_media_facet', 'entity_facet'] as $facette) {\n355\t\t\t$sql    = facette_sql($facette, [], ['checkAvailabilityOnly' => true]);\n356\t\t\t$moteur = facette_moteur($plugin, $facette, [], ['checkAvailabilityOnly' => true]);\n357\t\t\test_vrai($moteur !== null, \"{$facette} — le pont a décliné la disponibilité\");\n358\t\t\test_egal((bool)$sql, (bool)$moteur, \"{$facette} — disponibilité\");\n359\t\t}\n360\t});\n361\t\n362\tverifier('une facette has déjà en critère disparaît, des deux côtés', function () use ($plugin) {\n363\t\t$criteres = ['has_media_facet' => ['1']];\n364\t\t$sql    = facette_sql('has_media_facet', $criteres);\n365\t\t$moteur = facette_moteur($plugin, 'has_media_facet', $criteres);\n366\t\test_egal([], $sql ?: [], 'côté SQL');\n367\t\test_egal([], $moteur ?: [], 'côté moteur');\n368\t});\n369\t\n370\t# ----------------------------------------------------------------------\n371\t# Déclins attendus : ce que le pont ne traduit pas, il le laisse au SQL\n372\t# ----------------------------------------------------------------------\n373\t\n374\tverifier('les facettes non traduites déclinent proprement', function () use ($plugin) {\n375\t\tforeach (['year_facet', 'transcribable_facet', 'title_facet', 'violation_facet'] as $facette) {\n376\t\t\t$b = caGetBrowseInstance('ca_objects');\n377\t\t\t$info = $b->getInfoForFacet($facette);\n378\t\t\tif (!is_array($info)) { continue; }\n379\t\t\t$resultat = $plugin->getBrowseFacetContent($b, $facette, $info, []);\n380\t\t\test_vrai($resultat === null, \"{$facette} devrait décliner, a rendu \" . gettype($resultat));\n381\t\t}\n382\t});\n383\t\n384\tverifier('une recherche à syntaxe Lucene fait décliner tout le browse', function () use ($plugin) {\n385\t\t$criteres = ['_search' => ['oil AND canvas']];\n386\t\t$b = browse_avec([]);   // les critères sont posés à la main pour éviter l'execute\n387\t\t$b->addCriteria('_search', ['oil AND canvas']);\n388\t\t$info = $b->getInfoForFacet('type_facet');\n389\t\t$resultat = $plugin->getBrowseFacetContent($b, 'type_facet', $info, []);\n390\t\test_vrai($resultat === null, 'une expression booléenne doit décliner, a rendu ' . gettype($resultat));\n391\t});\n392\t\n393\texit(bilan());\n394\t"}]},"uuid":"e16437ad-b363-41cc-b37f-8ffc13bbd832","timestamp":"2026-08-19T10:30:34.277Z","sourceToolAssistantUUID":"1bec2cb3-28be-4eec-8378-109b6b512bef","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/gautier/git/lescollections/meilisearch","sessionId":"8f9b4c71-76ba-45d0-a77c-f69b92544b91","version":"2.1.235","gitBranch":"main"}
{"parentUuid":"de3f78a3-4943-4bac-850b-b4cfa41ac9f0","isSidechain":true,"promptId":"5459b1ec-9358-4e86-9ad4-5a94fd6ff28b","agentId":"aa6cd2aa148ac9212","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ja7CLZXr5BqjSwMcpfGMN6","type":"tool_result","content":"1\t<?php\n2\t/* ----------------------------------------------------------------------\n3\t * MeilisearchSearchEngine/Facets.php — le pont entre le Browse et les facettes du moteur.\n4\t *\n5\t * Le BrowseEngine de CollectiveAccess calcule chaque facette par un GROUP BY, restreint au\n6\t * résultat courant par une clause `IN (…)` portant la liste littérale des identifiants — à\n7\t * 300 000 résultats et dix facettes, chaque page fabrique dix requêtes de plusieurs Mo. Ici,\n8\t * la même question est posée à Meilisearch : les critères du browse deviennent un `filter`,\n9\t * la distribution (`facetDistribution`) rend les comptes par valeur, et CollectiveAccess ne\n10\t * fait plus que ce qu'il fait bien — convertir des identifiants en libellés.\n11\t *\n12\t * La règle de sûreté est unique et sans exception : **traduire exactement ou décliner**.\n13\t * Toute option de facette, tout critère, tout état du browse qui ne se traduit pas à\n14\t * l'identique fait rendre `null`, et le socle continue en SQL comme si ce fichier n'existait\n15\t * pas. Un browse aux comptes faux est pire qu'un browse lent.\n16\t *\n17\t * Périmètre traduit (phase 1) : les types `fieldList`, `has` et `authority`, les restrictions\n18\t * d'accès et de type/source du browse, et le critère `_search` quand l'expression est un\n19\t * texte nu. Restent au SQL : `location`, `checkouts`, `violations`, `tags`, `dupeidno`,\n20\t * `normalized*`, `attribute`, `label`, `field`, `hierarchy`, ainsi que `relative_to`,\n21\t * `filter`, les ACL par enregistrement et les relations réflexives.\n22\t *\n23\t * Correspondance des sémantiques, vérifiée sur le code du socle :\n24\t *   – un critère `authority` s'applique en SQL avec expansion descendante (bornes\n25\t *     hiérarchiques, BrowseEngine::execute()) ; ici, chaque document porte les ancêtres de\n26\t *     ses liens (`facet__ca_places` contient Addis-Abeba ET l'Abyssinie), le filtre d'égalité\n27\t *     couvre donc les descendants par construction ;\n28\t *   – les valeurs multiples d'une même facette s'intersectent (une par ensemble), sauf\n29\t *     `multiple = 1` où elles s'unissent — comme dans execute() ;\n30\t *   – le compte d'un ancêtre est ici le nombre de documents distincts sous sa branche, là où\n31\t *     le SQL additionne les comptes des descendants (un objet lié à deux descendants y compte\n32\t *     deux fois). Notre compte est le bon ; l'écart est toléré par le test d'équivalence.\n33\t * ---------------------------------------------------------------------- */\n34\t\n35\tnamespace Meilisearch;\n36\t\n37\trequire_once(__CA_LIB_DIR__ . '/Plugins/SearchEngine/Meilisearch/Schema.php');\n38\trequire_once(__CA_LIB_DIR__ . '/Plugins/SearchEngine/Meilisearch/Log.php');\n39\t\n40\tclass Facets {\n41\t\t/** @var \\WLPlugSearchEngineMeilisearch */\n42\t\tprivate $engine;\n43\t\n44\t\t/** @var Schema */\n45\t\tprivate $schema;\n46\t\n47\t\t/** @var \\Db */\n48\t\tprivate $db;\n49\t\n50\t\t/** @var array cache des listes de valeurs : [list_code] => [items par id, items par valeur, tri] */\n51\t\tprivate static $list_cache = [];\n52\t\n53\t\tpublic function __construct($engine) {\n54\t\t\t$this->engine = $engine;\n55\t\t\t$this->schema = $engine->getSchema();\n56\t\t\t$this->db     = new \\Db();\n57\t\t}\n58\t\n59\t\t# -------------------------------------------------------\n60\t\t# Point d'entrée\n61\t\t# -------------------------------------------------------\n62\t\n63\t\t/**\n64\t\t * Contenu d'une facette, calculé par Meilisearch — ou `null` pour laisser le SQL faire.\n65\t\t *\n66\t\t * @param \\BrowseEngine $browse     Le browse courant (critères, restrictions).\n67\t\t * @param string        $facet_name Nom de la facette dans browse.conf.\n68\t\t * @param array         $facet_info Configuration de la facette.\n69\t\t * @param array         $options    Options de getFacetContent() (checkAccess, checkAvailabilityOnly…).\n70\t\t *\n71\t\t * @return array|bool|null Le contenu au format du socle, un booléen si checkAvailabilityOnly,\n72\t\t *         ou null pour décliner.\n73\t\t */\n74\t\tpublic function facetContent($browse, string $facet_name, array $facet_info, array $options) {\n75\t\t\t$type = $facet_info['type'] ?? null;\n76\t\t\tif (!in_array($type, ['fieldList', 'has', 'authority'], true)) { return null; }\n77\t\n78\t\t\t// Options de facette sans traduction exacte : au SQL.\n79\t\t\tforeach (['relative_to', 'filter', 'filter_values', 'single_value', 'exclude_values', 'suppress',\n80\t\t\t\t'restrict_to_lists', 'exclude_relationship_types', 'filter_on_interstitial'] as $key) {\n81\t\t\t\tif (!empty($facet_info[$key])) { return null; }\n82\t\t\t}\n83\t\t\t// L'index porte toujours les ancêtres : une facette qui refuse l'expansion\n84\t\t\t// hiérarchique rendrait des comptes plus larges que son SQL.\n85\t\t\tif ($type === 'authority'\n86\t\t\t\t&& (!empty($facet_info['dontExpandHierarchically']) || !empty($facet_info['dont_expand_hierarchically']))) {\n87\t\t\t\treturn null;\n88\t\t\t}\n89\t\n90\t\t\t$t_subject = $browse->getSubjectInstance();\n91\t\t\tif (!$t_subject) { return null; }\n92\t\t\tif (function_exists('caACLIsEnabled') && caACLIsEnabled($t_subject)) { return null; }\n93\t\n94\t\t\t$subject_table = $t_subject->tableName();\n95\t\t\t$index         = $this->schema->indexName($subject_table);\n96\t\n97\t\t\t// Un index sans aucun attribut de facette date d'avant cette version du connecteur :\n98\t\t\t// tout décliner tant qu'une réindexation ne l'a pas mis au niveau.\n99\t\t\tif (!$this->indexHasFacets($index)) { return null; }\n100\t\n101\t\t\t$state = $this->translateBrowseState($browse, $t_subject, $options);\n102\t\t\tif ($state === null) { return null; }\n103\t\t\tlist($q, $filter_clauses) = $state;\n104\t\n105\t\t\ttry {\n106\t\t\t\tswitch ($type) {\n107\t\t\t\t\tcase 'fieldList':\n108\t\t\t\t\t\treturn $this->fieldListFacet($browse, $index, $t_subject, $facet_name, $facet_info, $options, $q, $filter_clauses);\n109\t\t\t\t\tcase 'has':\n110\t\t\t\t\t\treturn $this->hasFacet($browse, $index, $t_subject, $facet_name, $facet_info, $options, $q, $filter_clauses);\n111\t\t\t\t\tcase 'authority':\n112\t\t\t\t\t\treturn $this->authorityFacet($browse, $index, $t_subject, $facet_name, $facet_info, $options, $q, $filter_clauses);\n113\t\t\t\t}\n114\t\t\t} catch (ClientException $e) {\n115\t\t\t\t// Moteur en panne : le browse doit rester utilisable, le SQL prend le relais.\n116\t\t\t\tLog::error(\"Facette « {$facet_name} » sur {$index} : \" . $e->getMessage());\n117\t\t\t\treturn null;\n118\t\t\t}\n119\t\n120\t\t\treturn null;\n121\t\t}\n122\t\n123\t\t# -------------------------------------------------------\n124\t\t# Traduction de l'état du browse\n125\t\t# -------------------------------------------------------\n126\t\n127\t\t/**\n128\t\t * Traduit l'état courant du browse — critères posés et restrictions transversales — en\n129\t\t * une requête Meilisearch : un `q` (au plus un critère _search, en texte nu) et des\n130\t\t * clauses de filtre conjointes.\n131\t\t *\n132\t\t * @return array|null [q, clauses] — null si un seul élément ne se traduit pas exactement.\n133\t\t */\n134\t\tprivate function translateBrowseState($browse, $t_subject, array $options): ?array {\n135\t\t\t$subject_table = $t_subject->tableName();\n136\t\t\t$index         = $this->schema->indexName($subject_table);\n137\t\t\t$fields        = $this->engine->indexFields($index);\n138\t\n139\t\t\t$q       = '';\n140\t\t\t$clauses = [];\n141\t\n142\t\t\t$criteria = $browse->getCriteria();\n143\t\t\tif (!is_array($criteria)) { $criteria = []; }\n144\t\n145\t\t\tforeach ($criteria as $criterion_facet => $values) {\n146\t\t\t\t$values = array_keys(array_filter(is_array($values) ? $values : []));\n147\t\t\t\tif (!sizeof($values)) { continue; }\n148\t\n149\t\t\t\tif ($criterion_facet === '_search') {\n150\t\t\t\t\t$q = $this->translateSearch($values);\n151\t\t\t\t\tif ($q === null) { return null; }\n152\t\t\t\t\tcontinue;\n153\t\t\t\t}\n154\t\t\t\tif ($criterion_facet === '_reltypes') { return null; }\n155\t\n156\t\t\t\t$info = $browse->getInfoForFacet($criterion_facet);\n157\t\t\t\tif (!is_array($info)) { return null; }\n158\t\t\t\tforeach (['relative_to', 'filter_on_interstitial', 'exclude_relationship_types'] as $key) {\n159\t\t\t\t\tif (!empty($info[$key])) { return null; }\n160\t\t\t\t}\n161\t\n162\t\t\t\t$clause = null;\n163\t\t\t\tswitch ($info['type'] ?? null) {\n164\t\t\t\t\tcase 'fieldList':\n165\t\t\t\t\t\t$clause = $this->fieldListCriterion($subject_table, $info, $values, $fields, $options);\n166\t\t\t\t\t\tbreak;\n167\t\t\t\t\tcase 'has':\n168\t\t\t\t\t\t$clause = $this->hasCriterion($subject_table, $info, $values, $fields);\n169\t\t\t\t\t\tbreak;\n170\t\t\t\t\tcase 'authority':\n171\t\t\t\t\t\t$clause = $this->authorityCriterion($subject_table, $info, $values);\n172\t\t\t\t\t\tbreak;\n173\t\t\t\t\tdefault:\n174\t\t\t\t\t\treturn null;   // type de critère non traduit\n175\t\t\t\t}\n176\t\t\t\tif ($clause === null) { return null; }\n177\t\t\t\tif (strlen($clause)) { $clauses[] = $clause; }\n178\t\t\t}\n179\t\n180\t\t\t// Restrictions transversales. Chacune exige que le champ soit réellement dans\n181\t\t\t// l'index : filtrer sur un attribut absent rendrait des comptes faux en silence.\n182\t\t\tif (($check_access = $options['checkAccess'] ?? null) && is_array($check_access) && sizeof($check_access) && $t_subject->hasField('access')) {\n183\t\t\t\t$attr = $this->schema->fieldName($subject_table, 'access');\n184\t\t\t\tif (!in_array($attr, $fields, true)) { return null; }\n185\t\t\t\t$clauses[] = $attr . ' IN ' . $this->inList($check_access);\n186\t\t\t}\n187\t\n188\t\t\tif (($type_ids = $browse->getTypeRestrictionList()) && is_array($type_ids) && sizeof($type_ids)) {\n189\t\t\t\t$attr = $this->schema->fieldName($subject_table, 'type_id');\n190\t\t\t\tif (!in_array($attr, $fields, true)) { return null; }\n191\t\t\t\t$clause = $attr . ' IN ' . $this->inList($type_ids);\n192\t\t\t\tif ($t_subject->getFieldInfo('type_id', 'IS_NULL')) {\n193\t\t\t\t\t$clause = '(' . $clause . ' OR ' . $attr . ' NOT EXISTS)';\n194\t\t\t\t}\n195\t\t\t\t$clauses[] = $clause;\n196\t\t\t}\n197\t\n198\t\t\tif (method_exists($t_subject, 'getSourceFieldName') && $t_subject->getSourceFieldName()\n199\t\t\t\t&& ($source_ids = $browse->getSourceRestrictionList()) && is_array($source_ids) && sizeof($source_ids)) {\n200\t\t\t\t$attr = $this->schema->fieldName($subject_table, $t_subject->getSourceFieldName());\n201\t\t\t\tif (!in_array($attr, $fields, true)) { return null; }\n202\t\t\t\t$clauses[] = $attr . ' IN ' . $this->inList($source_ids);\n203\t\t\t}\n204\t\n205\t\t\tif (!empty($options['filterDeaccessionedRecords']) && $t_subject->hasField('is_deaccessioned')) {\n206\t\t\t\t$attr = $this->schema->fieldName($subject_table, 'is_deaccessioned');\n207\t\t\t\tif (!in_array($attr, $fields, true)) { return null; }\n208\t\t\t\t$clauses[] = $attr . ' IN ' . $this->inList([0]);\n209\t\t\t}\n210\t\n211\t\t\t// Ceinture et bretelles : les enregistrements supprimés sont désindexés, mais si le\n212\t\t\t// champ est là, le filtre ne coûte rien.\n213\t\t\tif ($t_subject->hasField('deleted')) {\n214\t\t\t\t$attr = $this->schema->fieldName($subject_table, 'deleted');\n215\t\t\t\tif (in_array($attr, $fields, true)) {\n216\t\t\t\t\t$clauses[] = $attr . ' IN ' . $this->inList([0]);\n217\t\t\t\t}\n218\t\t\t}\n219\t\n220\t\t\treturn [$q, $clauses];\n221\t\t}\n222\t\n223\t\t/**\n224\t\t * Le critère _search ne se traduit que s'il est un texte nu : dès qu'une syntaxe Lucene\n225\t\t * s'y glisse (champ qualifié, guillemets, parenthèses, booléens, joker, exclusion), la\n226\t\t * requête relève du parseur du socle et le browse entier est décliné.\n227\t\t */\n228\t\tprivate function translateSearch(array $expressions): ?string {\n229\t\t\t$expression = trim(join(' ', $expressions));\n230\t\t\tif (!strlen($expression) || $expression === '*') { return ''; }\n231\t\n232\t\t\tif (preg_match('![\":\\(\\)\\[\\]\\*\\?~^|!={}<>]!', $expression)) { return null; }\n233\t\t\tif (preg_match('!(^|\\s)(AND|OR|NOT)(\\s|$)!', $expression)) { return null; }\n234\t\t\tif (preg_match('!(^|\\s)[-+]\\S!', $expression)) { return null; }\n235\t\n236\t\t\treturn $expression;\n237\t\t}\n238\t\n239\t\t/**\n240\t\t * Critère fieldList : la valeur choisie, étendue à ses enfants directs — la même\n241\t\t * expansion que fait execute(). Les valeurs d'une facette ordinaire s'intersectent ;\n242\t\t * `multiple = 1` les unit.\n243\t\t */\n244\t\tprivate function fieldListCriterion(string $subject_table, array $info, array $values, array $fields, array $options): ?string {\n245\t\t\t$field = $info['field'] ?? null;\n246\t\t\tif (!$field || !empty($info['table'])) { return null; }\n247\t\n248\t\t\t$attr = $this->schema->fieldName($subject_table, $field);\n249\t\t\tif (!in_array($attr, $fields, true)) { return null; }\n250\t\n251\t\t\t$dont_expand = !empty($info['dontExpandHierarchically']) || !empty($info['dont_expand_hierarchically']);\n252\t\n253\t\t\t$per_value = [];\n254\t\t\tforeach ($values as $value) {\n255\t\t\t\t$ids = [$value];\n256\t\t\t\tif (!in_array($field, ['access', 'status'], true) && !$dont_expand) {\n257\t\t\t\t\t$t_item = \\ca_list_items::find((int)$value, ['returnAs' => 'firstModelInstance']);\n258\t\t\t\t\tif (!$t_item) { return null; }\n259\t\t\t\t\t$children = $t_item->get('ca_list_items.children.item_id', ['returnAsArray' => true]);\n260\t\t\t\t\tif (is_array($children)) { $ids = array_merge($ids, $children); }\n261\t\t\t\t}\n262\t\t\t\t$per_value[] = $attr . ' IN ' . $this->inList($ids);\n263\t\t\t}\n264\t\n265\t\t\tif (!empty($info['multiple'])) {\n266\t\t\t\treturn '(' . join(' OR ', $per_value) . ')';\n267\t\t\t}\n268\t\t\treturn '(' . join(' AND ', $per_value) . ')';\n269\t\t}\n270\t\n271\t\t/**\n272\t\t * Critère has : présence ou absence de l'attribut visé.\n273\t\t */\n274\t\tprivate function hasCriterion(string $subject_table, array $info, array $values, array $fields): ?string {\n275\t\t\t$attrs = $this->hasAttributes($subject_table, $info);\n276\t\t\tif ($attrs === null) { return null; }\n277\t\n278\t\t\t$per_value = [];\n279\t\t\tforeach ($values as $value) {\n280\t\t\t\tif ((int)$value) {\n281\t\t\t\t\t$exists = array_map(function ($a) { return $a . ' EXISTS'; }, $attrs);\n282\t\t\t\t\t$per_value[] = '(' . join(' OR ', $exists) . ')';\n283\t\t\t\t} else {\n284\t\t\t\t\t$missing = array_map(function ($a) { return $a . ' NOT EXISTS'; }, $attrs);\n285\t\t\t\t\t$per_value[] = '(' . join(' AND ', $missing) . ')';\n286\t\t\t\t}\n287\t\t\t}\n288\t\t\treturn '(' . join(' AND ', $per_value) . ')';\n289\t\t}\n290\t\n291\t\t/**\n292\t\t * Critère authority : égalité sur l'attribut de facette de la table liée. Les ancêtres\n293\t\t * étant indexés, l'égalité sur un nœud couvre sa descendance — la sémantique exacte de\n294\t\t * l'expansion hiérarchique d'execute().\n295\t\t */\n296\t\tprivate function authorityCriterion(string $subject_table, array $info, array $values): ?string {\n297\t\t\t$attr = $this->authorityAttribute($subject_table, $info);\n298\t\t\tif ($attr === null) { return null; }\n299\t\n300\t\t\t$ids = array_map('intval', $values);\n301\t\n302\t\t\tif (!empty($info['multiple'])) {\n303\t\t\t\treturn $attr . ' IN ' . $this->inList($ids);\n304\t\t\t}\n305\t\t\t$per_value = [];\n306\t\t\tforeach ($ids as $id) { $per_value[] = $attr . ' = ' . $id; }\n307\t\t\treturn '(' . join(' AND ', $per_value) . ')';\n308\t\t}\n309\t\n310\t\t# -------------------------------------------------------\n311\t\t# Calcul des facettes\n312\t\t# -------------------------------------------------------\n313\t\n314\t\t/**\n315\t\t * Facette fieldList : distribution d'un intrinsèque adossé à une liste (type_id, status,\n316\t\t * access…), rendue au format du socle — un poste par valeur de liste, trié selon le tri\n317\t\t * par défaut de la liste.\n318\t\t */\n319\t\tprivate function fieldListFacet($browse, string $index, $t_subject, string $facet_name, array $facet_info, array $options, string $q, array $clauses) {\n320\t\t\t$subject_table = $t_subject->tableName();\n321\t\t\t$field         = $facet_info['field'] ?? null;\n322\t\t\tif (!$field || !empty($facet_info['table'])) { return null; }\n323\t\n324\t\t\t$field_info = \\Datamodel::getFieldInfo($subject_table, $field);\n325\t\t\tif (!is_array($field_info)) { return null; }\n326\t\t\t$list_code = $field_info['LIST_CODE'] ?? ($field_info['LIST'] ?? null);\n327\t\t\tif (!$list_code) { return null; }\n328\t\t\t$by_value = !isset($field_info['LIST_CODE']);\n329\t\n330\t\t\t$attr = $this->schema->fieldName($subject_table, $field);\n331\t\t\tif (!in_array($attr, $this->engine->indexFields($index), true)) {\n332\t\t\t\t// Champ jamais indexé : impossible de compter juste.\n333\t\t\t\treturn null;\n334\t\t\t}\n335\t\n336\t\t\t$distribution = $this->distribution($index, $attr, $q, $clauses);\n337\t\t\tif ($distribution === null) { return null; }\n338\t\n339\t\t\tlist($items_by_id, $items_by_value, $sort_key) = $this->listItems($list_code);\n340\t\n341\t\t\t$criteria = $browse->getCriteria($facet_name);\n342\t\t\tif (!is_array($criteria)) { $criteria = []; }\n343\t\n344\t\t\t// Le filtre d'accès du socle porte aussi sur les items de liste eux-mêmes\n345\t\t\t// (`li.access IN (…)`) : un type dont l'item n'est pas public disparaît de la facette.\n346\t\t\t$check_access = null;\n347\t\t\tif (!empty($options['checkAccess']) && is_array($options['checkAccess'])) {\n348\t\t\t\t$check_access = array_map('intval', $options['checkAccess']);\n349\t\t\t}\n350\t\n351\t\t\t$values = [];\n352\t\t\tforeach ($distribution as $value => $count) {\n353\t\t\t\t$value = (string)$value;\n354\t\t\t\tif (isset($criteria[$value])) { continue; }   // déjà en critère : ne pas re-proposer\n355\t\n356\t\t\t\t$item = $by_value ? ($items_by_value[$value] ?? null) : ($items_by_id[$value] ?? null);\n357\t\t\t\tif (!$item) { continue; }   // valeur hors liste : même silence que le SQL\n358\t\t\t\tif ($check_access !== null && $item['access'] !== null && !in_array((int)$item['access'], $check_access, true)) { continue; }\n359\t\n360\t\t\t\t$values[$value] = [\n361\t\t\t\t\t'id'            => $value,\n362\t\t\t\t\t'label'         => $item['label'],\n363\t\t\t\t\t'sort'          => $sort_key ? ($item[$sort_key] ?? null) : null,\n364\t\t\t\t\t'content_count' => (int)$count,\n365\t\t\t\t];\n366\t\t\t}\n367\t\n368\t\t\tif (!empty($options['checkAvailabilityOnly'])) {\n369\t\t\t\t// Même règle que le SQL : une facette à valeur unique ne discrimine rien.\n370\t\t\t\treturn sizeof($values) > 1;\n371\t\t\t}\n372\t\n373\t\t\tif (function_exists('caSortArrayByKeyInValue')) {\n374\t\t\t\t$values = caSortArrayByKeyInValue($values, ['sort']);\n375\t\t\t}\n376\t\t\treturn $values;\n377\t\t}\n378\t\n379\t\t/**\n380\t\t * Facette has : deux comptes exacts — avec et sans — en un seul aller-retour. La règle du\n381\t\t * socle est conservée : si l'une des deux options est vide, la facette entière disparaît.\n382\t\t */\n383\t\tprivate function hasFacet($browse, string $index, $t_subject, string $facet_name, array $facet_info, array $options, string $q, array $clauses) {\n384\t\t\t$all_criteria = $browse->getCriteria();\n385\t\t\tif (isset($all_criteria[$facet_name])) { return []; }   // une seule occurrence par browse\n386\t\n387\t\t\t$attrs = $this->hasAttributes($t_subject->tableName(), $facet_info);\n388\t\t\tif ($attrs === null) { return null; }\n389\t\n390\t\t\t$exists  = '(' . join(' OR ', array_map(function ($a) { return $a . ' EXISTS'; }, $attrs)) . ')';\n391\t\t\t$missing = '(' . join(' AND ', array_map(function ($a) { return $a . ' NOT EXISTS'; }, $attrs)) . ')';\n392\t\n393\t\t\t$base = ['q' => $q, 'hitsPerPage' => 0, 'page' => 1, 'attributesToRetrieve' => [Schema::PK]];\n394\t\t\t$responses = $this->engine->getClient()->multiSearch([\n395\t\t\t\tarray_merge($base, ['indexUid' => $index, 'filter' => $this->filterString(array_merge($clauses, [$exists]))]),\n396\t\t\t\tarray_merge($base, ['indexUid' => $index, 'filter' => $this->filterString(array_merge($clauses, [$missing]))]),\n397\t\t\t]);\n398\t\n399\t\t\t$yes = (int)($responses[0]['totalHits'] ?? 0);\n400\t\t\t$no  = (int)($responses[1]['totalHits'] ?? 0);\n401\t\n402\t\t\tif (!empty($options['checkAvailabilityOnly'])) {\n403\t\t\t\treturn ($yes > 0) && ($no > 0);\n404\t\t\t}\n405\t\t\tif (!$yes || !$no) { return []; }\n406\t\n407\t\t\t$yes_text = !empty($facet_info['label_yes']) ? $facet_info['label_yes'] : _t('Yes');\n408\t\t\t$no_text  = !empty($facet_info['label_no'])  ? $facet_info['label_no']  : _t('No');\n409\t\n410\t\t\treturn [\n411\t\t\t\t'yes' => ['id' => 1, 'label' => $yes_text, 'content_count' => $yes],\n412\t\t\t\t'no'  => ['id' => 0, 'label' => $no_text,  'content_count' => $no],\n413\t\t\t];\n414\t\t}\n415\t\n416\t\t/**\n417\t\t * Facette authority : distribution des identifiants liés — ancêtres compris, donc\n418\t\t * l'arborescence arrive déjà agrégée — puis libellés et généalogie relus en SQL, comme le\n419\t\t * socle le fait lui-même (trois requêtes séparées y sont plus rapides qu'une jointure).\n420\t\t */\n421\t\tprivate function authorityFacet($browse, string $index, $t_subject, string $facet_name, array $facet_info, array $options, string $q, array $clauses) {\n422\t\t\t$subject_table = $t_subject->tableName();\n423\t\t\t$table         = $facet_info['table'] ?? null;\n424\t\t\tif (!$table || $table === $subject_table) { return null; }   // relations réflexives : au SQL\n425\t\n426\t\t\t$attr = $this->authorityAttribute($subject_table, $facet_info);\n427\t\t\tif ($attr === null) { return null; }\n428\t\n429\t\t\tif (!in_array($attr, $this->engine->indexFields($index), true)) {\n430\t\t\t\t// Aucun document ne porte cette facette : contenu réellement vide.\n431\t\t\t\treturn !empty($options['checkAvailabilityOnly']) ? false : [];\n432\t\t\t}\n433\t\n434\t\t\t$t_rel = \\Datamodel::getInstanceByTableName($table, true);\n435\t\t\tif (!$t_rel) { return null; }\n436\t\n437\t\t\t// Pour une table hiérarchique, la distribution des liens directs s'obtient dans la\n438\t\t\t// même requête : le socle traite différemment un enregistrement lié (conservé même\n439\t\t\t// sans type ni accès) et un nœud présent par simple ascendance (écarté dans ce cas).\n440\t\t\t$rel_types  = $facet_info['restrict_to_relationship_types'] ?? null;\n441\t\t\t$rel_code   = (is_array($rel_types) && sizeof($rel_types) === 1) ? (string)reset($rel_types) : null;\n442\t\t\t$direct_attr = $t_rel->isHierarchical() ? $this->schema->directFacetAttribute($table, $rel_code) : null;\n443\t\n444\t\t\tif ($direct_attr) {\n445\t\t\t\t$both = $this->distribution($index, [$attr, $direct_attr], $q, $clauses);\n446\t\t\t\t$distribution = is_array($both[$attr] ?? null) ? $both[$attr] : [];\n447\t\t\t\t$direct       = is_array($both[$direct_attr] ?? null) ? $both[$direct_attr] : [];\n448\t\t\t} else {\n449\t\t\t\t$distribution = $this->distribution($index, $attr, $q, $clauses);\n450\t\t\t\t$direct       = null;\n451\t\t\t}\n452\t\n453\t\t\tif (!empty($options['checkAvailabilityOnly'])) {\n454\t\t\t\treturn sizeof($distribution) > 0;\n455\t\t\t}\n456\t\t\tif (!sizeof($distribution)) { return []; }\n457\t\n458\t\t\t$criteria = $browse->getCriteria($facet_name);\n459\t\t\tif (!is_array($criteria)) { $criteria = []; }\n460\t\n461\t\t\t$restrict_to_types = [];\n462\t\t\tif (!empty($facet_info['restrict_to_types']) && function_exists('caMakeTypeIDList')) {\n463\t\t\t\t$restrict_to_types = caMakeTypeIDList($table, $facet_info['restrict_to_types']);\n464\t\t\t}\n465\t\t\t$exclude_types = [];\n466\t\t\tif (!empty($facet_info['exclude_types']) && function_exists('caMakeTypeIDList')) {\n467\t\t\t\t$exclude_types = caMakeTypeIDList($table, $facet_info['exclude_types']);\n468\t\t\t}\n469\t\n470\t\t\t$check_access = null;\n471\t\t\tif (!empty($options['checkAccess']) && is_array($options['checkAccess']) && $t_rel->hasField('access')) {\n472\t\t\t\t$check_access = array_map('intval', $options['checkAccess']);\n473\t\t\t}\n474\t\n475\t\t\t$rows = $this->authorityRows($t_rel, array_map('intval', array_keys($distribution)));\n476\t\n477\t\t\t$items = [];\n478\t\t\tforeach ($distribution as $id => $count) {\n479\t\t\t\t$id = (int)$id;\n480\t\t\t\tif (isset($criteria[$id]) || isset($criteria[(string)$id])) { continue; }\n481\t\n482\t\t\t\t$row = $rows[$id] ?? null;\n483\t\t\t\tif (!$row) { continue; }   // supprimé ou disparu depuis l'indexation\n484\t\n485\t\t\t\t// Le sort d'un enregistrement dépend de la façon dont il entre dans la facette.\n486\t\t\t\t// Un lien direct est conservé même sans type ni accès (le socle le marque\n487\t\t\t\t// seulement `no_access`) ; un nœud présent par simple ascendance est écarté dès\n488\t\t\t\t// qu'il n'a pas de type, pas d'accès, ou sort des restrictions — les mêmes règles\n489\t\t\t\t// que l'expansion d'ancêtres du socle.\n490\t\t\t\t$est_direct = ($direct === null) || isset($direct[(string)$id]) || isset($direct[$id]);\n491\t\t\t\t$sans_acces = ($check_access !== null && isset($row['access']) && !in_array((int)$row['access'], $check_access, true));\n492\t\n493\t\t\t\tif (!$est_direct) {\n494\t\t\t\t\tif (!$row['type_id']) { continue; }\n495\t\t\t\t\tif ($sans_acces) { continue; }\n496\t\t\t\t}\n497\t\t\t\tif (sizeof($restrict_to_types) && !in_array((int)$row['type_id'], $restrict_to_types)) { continue; }\n498\t\t\t\tif (sizeof($exclude_types) && in_array((int)$row['type_id'], $exclude_types)) { continue; }\n499\t\t\t\tif ($est_direct && $sans_acces && sizeof($restrict_to_types)) { continue; }\n500\t\n501\t\t\t\t$items[$id] = [\n502\t\t\t\t\t'id'            => $id,\n503\t\t\t\t\t'type_id'       => $row['type_id'] ? [$row['type_id']] : [],\n504\t\t\t\t\t'parent_id'     => $row['parent_id'] ?? null,\n505\t\t\t\t\t'hierarchy_id'  => $row['hierarchy_id'] ?? null,\n506\t\t\t\t\t'rel_type_id'   => [],\n507\t\t\t\t\t'child_count'   => 0,\n508\t\t\t\t\t'content_count' => (int)$count,\n509\t\t\t\t\t'label'         => $row['label'],\n510\t\t\t\t];\n511\t\t\t\tif ($est_direct && $sans_acces) { $items[$id]['no_access'] = 1; }\n512\t\t\t}\n513\t\n514\t\t\t// Compte d'enfants directs présents dans la facette, pour l'affichage hiérarchique.\n515\t\t\tforeach ($items as $item) {\n516\t\t\t\t$parent_id = $item['parent_id'];\n517\t\t\t\tif ($parent_id && isset($items[$parent_id])) { $items[$parent_id]['child_count']++; }\n518\t\t\t}\n519\t\n520\t\t\tuasort($items, function ($a, $b) {\n521\t\t\t\treturn strnatcasecmp((string)$a['label'], (string)$b['label']);\n522\t\t\t});\n523\t\n524\t\t\treturn $items;\n525\t\t}\n526\t\n527\t\t# -------------------------------------------------------\n528\t\t# Aides\n529\t\t# -------------------------------------------------------\n530\t\n531\t\t/**\n532\t\t * Une requête, toutes les valeurs : la distribution exhaustive d'un ou plusieurs\n533\t\t * attributs sur le résultat courant du browse.\n534\t\t *\n535\t\t * @param string|array $attrs\n536\t\t * @return array [valeur => compte] pour un attribut unique, sinon [attribut => [valeur => compte]]\n537\t\t */\n538\t\tprivate function distribution(string $index, $attrs, string $q, array $clauses): array {\n539\t\t\t$attrs = is_array($attrs) ? $attrs : [$attrs];\n540\t\t\t$params = [\n541\t\t\t\t'q'                    => $q,\n542\t\t\t\t'limit'                => 0,\n543\t\t\t\t'facets'               => $attrs,\n544\t\t\t\t'attributesToRetrieve' => [Schema::PK],\n545\t\t\t];\n546\t\t\tif ($filter = $this->filterString($clauses)) { $params['filter'] = $filter; }\n547\t\n548\t\t\t$response = $this->engine->getClient()->search($index, $params);\n549\t\t\t$distributions = $response['facetDistribution'] ?? [];\n550\t\n551\t\t\tif (sizeof($attrs) === 1) {\n552\t\t\t\t$d = $distributions[$attrs[0]] ?? null;\n553\t\t\t\treturn is_array($d) ? $d : [];\n554\t\t\t}\n555\t\t\treturn is_array($distributions) ? $distributions : [];\n556\t\t}\n557\t\n558\t\t/**\n559\t\t * Attributs à interroger pour une facette ou un critère `has` : l'attribut d'un élément\n560\t\t * de métadonnée, ou la facette de la table liée — restreinte à ses types de relation si\n561\t\t * la configuration le demande.\n562\t\t */\n563\t\tprivate function hasAttributes(string $subject_table, array $info): ?array {\n564\t\t\tif (!empty($info['element_code'])) {\n565\t\t\t\t// Divergence connue et assumée : un attribut posé mais vide compte « oui » en SQL\n566\t\t\t\t// (sauf omit_blank_values) alors que l'index ne stocke jamais les vides. On ne\n567\t\t\t\t// traduit que la variante omit_blank_values, la seule dont le sens coïncide.\n568\t\t\t\tif (empty($info['omit_blank_values'])) { return null; }\n569\t\t\t\t$parts = explode('.', (string)$info['element_code']);\n570\t\t\t\treturn [$this->schema->fieldName($subject_table, array_pop($parts))];\n571\t\t\t}\n572\t\n573\t\t\t$table = $info['table'] ?? null;\n574\t\t\tif (!$table || !in_array($table, Schema::FACET_TABLES, true)) { return null; }\n575\t\n576\t\t\t$rel_types = $info['restrict_to_relationship_types'] ?? null;\n577\t\t\tif (is_array($rel_types) && sizeof($rel_types)) {\n578\t\t\t\t$attrs = [];\n579\t\t\t\tforeach ($rel_types as $code) {\n580\t\t\t\t\tif (!is_string($code) || !strlen($code)) { return null; }   // ids numériques : au SQL\n581\t\t\t\t\t$attrs[] = $this->schema->facetAttribute($table, $code);\n582\t\t\t\t}\n583\t\t\t\treturn $attrs;\n584\t\t\t}\n585\t\n586\t\t\treturn [$this->schema->facetAttribute($table)];\n587\t\t}\n588\t\n589\t\t/**\n590\t\t * Attribut de facette d'une autorité, compte tenu d'une éventuelle restriction à un type\n591\t\t * de relation. Plusieurs types ne s'agrègent pas sans double compte : au SQL.\n592\t\t */\n593\t\tprivate function authorityAttribute(string $subject_table, array $info): ?string {\n594\t\t\t$table = $info['table'] ?? null;\n595\t\t\tif (!$table || !in_array($table, Schema::FACET_TABLES, true)) { return null; }\n596\t\n597\t\t\t$rel_types = $info['restrict_to_relationship_types'] ?? null;\n598\t\t\tif (is_array($rel_types) && sizeof($rel_types)) {\n599\t\t\t\tif (sizeof($rel_types) > 1) { return null; }\n600\t\t\t\t$code = reset($rel_types);\n601\t\t\t\tif (!is_string($code) || !strlen($code)) { return null; }\n602\t\t\t\treturn $this->schema->facetAttribute($table, $code);\n603\t\t\t}\n604\t\n605\t\t\treturn $this->schema->facetAttribute($table);\n606\t\t}\n607\t\n608\t\t/**\n609\t\t * Libellés et généalogie des enregistrements d'autorité, en deux requêtes — la même\n610\t\t * décomposition que le socle, qui l'a mesurée plus rapide que la jointure.\n611\t\t *\n612\t\t * @return array [id => [label, parent_id, hierarchy_id, type_id, access]]\n613\t\t */\n614\t\tprivate function authorityRows($t_rel, array $ids): array {\n615\t\t\tif (!sizeof($ids)) { return []; }\n616\t\n617\t\t\t$table = $t_rel->tableName();\n618\t\t\t$pk    = $t_rel->primaryKey();\n619\t\n620\t\t\t$fields = [$pk];\n621\t\t\tif ($t_rel->hasField('parent_id')) { $fields[] = 'parent_id'; }\n622\t\t\tif ($t_rel->hasField('type_id'))   { $fields[] = 'type_id'; }\n623\t\t\tif ($t_rel->hasField('access'))    { $fields[] = 'access'; }\n624\t\t\tif ($hier_id_fld = $t_rel->getProperty('HIERARCHY_ID_FLD')) { $fields[] = $hier_id_fld; }\n625\t\t\t$has_deleted = $t_rel->hasField('deleted');\n626\t\n627\t\t\t$rows = [];\n628\t\t\tforeach (array_chunk($ids, 5000) as $chunk) {\n629\t\t\t\t$qr = $this->db->query(\"\n630\t\t\t\t\tSELECT \" . join(', ', $fields) . \"\n631\t\t\t\t\tFROM {$table}\n632\t\t\t\t\tWHERE {$pk} IN (?)\" . ($has_deleted ? \" AND deleted = 0\" : ''), [$chunk]);\n633\t\t\t\twhile ($qr->nextRow()) {\n634\t\t\t\t\t$row = $qr->getRow();\n635\t\t\t\t\t$rows[(int)$row[$pk]] = [\n636\t\t\t\t\t\t'parent_id'    => $row['parent_id'] ?? null,\n637\t\t\t\t\t\t'type_id'      => $row['type_id'] ?? null,\n638\t\t\t\t\t\t'access'       => $row['access'] ?? null,\n639\t\t\t\t\t\t'hierarchy_id' => $hier_id_fld ? ($row[$hier_id_fld] ?? null) : null,\n640\t\t\t\t\t\t'label'        => null,\n641\t\t\t\t\t];\n642\t\t\t\t}\n643\t\t\t}\n644\t\n645\t\t\tif (method_exists($t_rel, 'getPreferredDisplayLabelsForIDs')) {\n646\t\t\t\t$labels = $t_rel->getPreferredDisplayLabelsForIDs(array_keys($rows));\n647\t\t\t\tforeach ($rows as $id => $row) {\n648\t\t\t\t\t$label = $labels[$id] ?? null;\n649\t\t\t\t\tif (is_array($label)) { $label = reset($label); }\n650\t\t\t\t\t$rows[$id]['label'] = strlen((string)$label) ? (string)$label : '???';\n651\t\t\t\t}\n652\t\t\t}\n653\t\n654\t\t\treturn $rows;\n655\t\t}\n656\t\n657\t\t/**\n658\t\t * Valeurs d'une liste, indexées par identifiant et par valeur, avec la clé de tri de la\n659\t\t * liste — l'équivalent du `$va_list_items_by_value` du socle, en cache par processus.\n660\t\t */\n661\t\tprivate function listItems(string $list_code): array {\n662\t\t\tif (isset(self::$list_cache[$list_code])) { return self::$list_cache[$list_code]; }\n663\t\n664\t\t\t$t_list = new \\ca_lists();\n665\t\t\t$by_id = $by_value = [];\n666\t\t\t$sort_key = 'label';\n667\t\n668\t\t\tif ($t_list->load(['list_code' => $list_code])) {\n669\t\t\t\tswitch ((int)$t_list->get('default_sort')) {\n670\t\t\t\t\tcase __CA_LISTS_SORT_BY_RANK__:       $sort_key = 'rank';       break;\n671\t\t\t\t\tcase __CA_LISTS_SORT_BY_VALUE__:      $sort_key = 'item_value'; break;\n672\t\t\t\t\tcase __CA_LISTS_SORT_BY_IDENTIFIER__: $sort_key = 'idno';       break;\n673\t\t\t\t\tdefault:                              $sort_key = 'label';      break;\n674\t\t\t\t}\n675\t\n676\t\t\t\t$items = $t_list->getItemsForList($list_code);\n677\t\t\t\tif (is_array($items) && function_exists('caExtractValuesByUserLocale')) {\n678\t\t\t\t\tforeach (caExtractValuesByUserLocale($items) as $item_id => $item) {\n679\t\t\t\t\t\t$entry = [\n680\t\t\t\t\t\t\t'label'      => $item['name_plural'] ?? ($item['name_singular'] ?? ($item['idno'] ?? (string)$item_id)),\n681\t\t\t\t\t\t\t'rank'       => $item['rank'] ?? null,\n682\t\t\t\t\t\t\t'item_value' => $item['item_value'] ?? null,\n683\t\t\t\t\t\t\t'idno'       => $item['idno'] ?? null,\n684\t\t\t\t\t\t\t'access'     => isset($item['access']) ? (int)$item['access'] : null,\n685\t\t\t\t\t\t];\n686\t\t\t\t\t\t$entry['label'] = (string)$entry['label'];\n687\t\t\t\t\t\t// La clé de tri « label » se lit dans l'entrée elle-même.\n688\t\t\t\t\t\t$entry['label_sort'] = $entry['label'];\n689\t\t\t\t\t\t$by_id[(string)$item_id] = $entry;\n690\t\t\t\t\t\tif (isset($item['item_value']) && strlen((string)$item['item_value'])) {\n691\t\t\t\t\t\t\t$by_value[(string)$item['item_value']] = $entry;\n692\t\t\t\t\t\t}\n693\t\t\t\t\t}\n694\t\t\t\t}\n695\t\t\t}\n696\t\n697\t\t\tif ($sort_key === 'label') { $sort_key = 'label_sort'; }\n698\t\n699\t\t\treturn self::$list_cache[$list_code] = [$by_id, $by_value, $sort_key];\n700\t\t}\n701\t\n702\t\t/**\n703\t\t * L'index porte-t-il au moins un attribut de facette ? Sinon, il date d'avant cette\n704\t\t * version du connecteur et tout est décliné jusqu'à réindexation.\n705\t\t */\n706\t\tprivate function indexHasFacets(string $index): bool {\n707\t\t\tforeach ($this->engine->indexFields($index) as $attr) {\n708\t\t\t\tif (strpos($attr, Schema::FACET) === 0) { return true; }\n709\t\t\t}\n710\t\t\treturn false;\n711\t\t}\n712\t\n713\t\tprivate function filterString(array $clauses): string {\n714\t\t\treturn join(' AND ', array_filter($clauses, 'strlen'));\n715\t\t}\n716\t\n717\t\t/**\n718\t\t * Liste `IN` du langage de filtre. Les intrinsèques adossés à des listes sont indexés en\n719\t\t * chaînes, les compteurs et bits en nombres : chaque valeur numérique est émise sous les\n720\t\t * deux formes, l'égalité de Meilisearch ne confondant jamais `1` et `\"1\"`.\n721\t\t */\n722\t\tprivate function inList(array $values): string {\n723\t\t\t$out = [];\n724\t\t\tforeach ($values as $value) {\n725\t\t\t\tif (is_int($value) || is_float($value)) {\n726\t\t\t\t\t$out[] = (string)$value;\n727\t\t\t\t\t$out[] = $this->quote((string)$value);\n728\t\t\t\t} elseif (is_numeric((string)$value)) {\n729\t\t\t\t\t$out[] = (string)$value;\n730\t\t\t\t\t$out[] = $this->quote((string)$value);\n731\t\t\t\t} else {\n732\t\t\t\t\t$out[] = $this->quote((string)$value);\n733\t\t\t\t}\n734\t\t\t}\n735\t\t\treturn '[' . join(', ', array_unique($out)) . ']';\n736\t\t}\n737\t\n738\t\tprivate function quote(string $value): string {\n739\t\t\treturn '\"' . str_replace(['\\\\', '\"'], ['\\\\\\\\', '\\\\\"'], $value) . '\"';\n740\t\t}\n741\t}\n742\t"}]},"uuid":"fb34ddbd-9d39-462c-bc18-b8fb8443c835","timestamp":"2026-08-19T10:30:34.509Z","sourceToolAssistantUUID":"de3f78a3-4943-4bac-850b-b4cfa41ac9f0","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/gautier/git/lescollections/meilisearch","sessionId":"8f9b4c71-76ba-45d0-a77c-f69b92544b91","version":"2.1.235","gitBranch":"main"}
