{"parentUuid":"8819b03a-fb60-4777-af63-f0e07a3c43c0","isSidechain":true,"promptId":"275019fc-672f-4da2-ae6a-23a9bfaec64f","agentId":"a9957ce9eb57cce68","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FUqGCfcwy4AH7z8CV5eT4w","type":"tool_result","content":"30\t * ----------------------------------------------------------------------\n31\t*/\n32\trequire_once(__CA_LIB_DIR__.'/BaseFindEngine.php');\n33\trequire_once(__CA_LIB_DIR__.'/Db.php');\n34\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/AuthorityAttributeValue.php');\n35\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/CollectionsAttributeValue.php');\n36\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/EntitiesAttributeValue.php');\n37\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/LoansAttributeValue.php');\n38\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/MovementsAttributeValue.php');\n39\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/ObjectLotsAttributeValue.php');\n40\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/ObjectRepresentationsAttributeValue.php');\n41\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/ObjectsAttributeValue.php');\n42\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/OccurrencesAttributeValue.php');\n43\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/PlacesAttributeValue.php');\n44\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/StorageLocationsAttributeValue.php');\n45\trequire_once(__CA_LIB_DIR__.'/Attributes/Values/ListAttributeValue.php');\n46\trequire_once(__CA_LIB_DIR__.'/Browse/BrowseResult.php');\n47\trequire_once(__CA_LIB_DIR__.'/Browse/BrowseCache.php');\n48\trequire_once(__CA_LIB_DIR__.'/Parsers/TimeExpressionParser.php');\n49\trequire_once(__CA_APP_DIR__.'/helpers/searchHelpers.php');\n50\trequire_once(__CA_APP_DIR__.'/helpers/accessHelpers.php');\n51\t\n52\tclass BrowseEngine extends BaseFindEngine {\n53\t\t# ------------------------------------------------------\n54\t\t# Properties\n55\t\t# ------------------------------------------------------\n56\t\t/**\n57\t\t * @var Table number of browse subject (ie. the kind of record we're browsing for)\n58\t\t */\n59\t\tprivate $opn_browse_table_num;\n60\t\n61\t\t/**\n62\t\t * @var Table name of browse subject\n63\t\t */\n64\t\tprivate $ops_browse_table_name;\n65\t\n66\t\t/**\n67\t\t * @var Instance of BrowseCache class\n68\t\t */\n69\t\tprivate $opo_ca_browse_cache;\n70\t\n71\t\t/**\n72\t\t * @var subject type_id to limit browsing to (eg. only browse ca_objects with type_id = 10)\n73\t\t */\n74\t\tprivate $opa_browse_type_ids = null;\n75\t\t\n76\t\t/**\n77\t\t * @var subject source_id to limit browsing to (eg. only browse ca_objects with source_id = 10)\n78\t\t */\n79\t\tprivate $opa_browse_source_ids = null;\n80\t\n81\t\t/**\n82\t\t * @var option to expand type restrictions hierarchically\n83\t\t */\n84\t\tprivate $opb_dont_expand_type_restrictions = false;\n85\t\tprivate $opb_dont_expand_source_restrictions = false;\n86\t\n87\t\t/**\n88\t\t * @var Instance of Db database client\n89\t\t */\n90\t\tprotected $opo_db;\n91\t\n92\t\t/**\n93\t\t * @var Instance of Configuration class loaded with application configuration (app.conf)\n94\t\t */\n95\t\tprivate $opo_config;\n96\t\n97\t\t/**\n98\t\t * @var Instance of Configuration class loaded with browse configuration (browse.conf)\n99\t\t */\n100\t\tprivate $opo_ca_browse_config;\n101\t\n102\t\t/**\n103\t\t * @var Array of browse settings loaded from browse.conf\n104\t\t */\n105\t\tprivate $opa_browse_settings;\n106\t\n107\t\t/**\n108\t\t * @var Array of filters to apply to browse results\n109\t\t */\n110\t\tprivate $opa_result_filters;\n111\t\n112\t\t/**\n113\t\t * @var\n114\t\t */\n115\t\tprivate $ops_facet_group = null;\n116\t\n117\t\t/**\n118\t\t * @var Flag indicating if browse criteria have changed since the last execute()\n119\t\t */\n120\t\tprivate $opb_criteria_have_changed = false;\n121\t\t\n122\t\t/**\n123\t\t * Terms used for matching in search\n124\t\t */\n125\t\tprotected $searched_terms = [];\n126\t\n127\t\t/**\n128\t\t * Description of matches by return row_id\n129\t\t */\n130\t\tprotected $seach_result_desc = [];\n131\t\t# ------------------------------------------------------\n132\t\t/**\n133\t\t * @var Type_id cache\n134\t\t */\n135\t\tstatic $s_type_id_cache = array();\n136\t\tstatic $s_source_id_cache = array();\n137\t\t# ------------------------------------------------------\n138\t\t/**\n139\t\t *\n140\t\t */\n141\t\tpublic function __construct($pm_subject_table_name_or_num, $pn_browse_id=null, $ps_browse_context='') {\n142\t\t\t$this->opo_db = new Db();\n143\t\t\tparent::__construct($this->opo_db);\n144\t\n145\t\t\t$this->opa_result_filters = array();\n146\t\n147\t\t\tif (is_numeric($pm_subject_table_name_or_num)) {\n148\t\t\t\t$this->opn_browse_table_num = intval($pm_subject_table_name_or_num);\n149\t\t\t\t$this->ops_browse_table_name = Datamodel::getTableName($this->opn_browse_table_num);\n150\t\t\t} else {\n151\t\t\t\t$this->opn_browse_table_num = Datamodel::getTableNum($pm_subject_table_name_or_num);\n152\t\t\t\t$this->ops_browse_table_name = $pm_subject_table_name_or_num;\n153\t\t\t}\n154\t\n155\t\t\t$this->opo_config = Configuration::load();\n156\t\t\t$this->opo_ca_browse_config = Configuration::load('browse.conf');\n157\t\t\t$this->opa_browse_settings = $this->opo_ca_browse_config->getAssoc($this->ops_browse_table_name);\n158\t\n159\t\t\t// Add \"virtual\" search facet - allows seeding of a browse with a search\n160\t\t\t$this->opa_browse_settings['facets']['_search'] = array(\n161\t\t\t\t'label_singular' => _t('Search'),\n162\t\t\t\t'label_plural' => _t('Searches')\n163\t\t\t);\n164\t\t\t// Add \"virtual\" relationship types facet - allows filtering of a browse by relationship types in a specific relationships (Eg. only return records that have at least one relationship with one of the specified types)\n165\t\t\t$this->opa_browse_settings['facets']['_reltypes'] = array(\n166\t\t\t\t'label_singular' => _t('Relationship type'),\n167\t\t\t\t'label_plural' => _t('Relationship types')\n168\t\t\t);\n169\t\t\t$this->_processBrowseSettings();\n170\t\n171\t\t\t$this->opo_ca_browse_cache = new BrowseCache();\n172\t\t\tif ($pn_browse_id) {\n173\t\t\t\t//$this->opo_ca_browse_cache->setParameter('table_num', $this->opn_browse_table_num);\n174\t\t\t\t$this->opo_ca_browse_cache->load($pn_browse_id);\n175\t\t\t} else {\n176\t\t\t\t$this->opo_ca_browse_cache->setParameter('table_num', $this->opn_browse_table_num);\n177\t\t\t\t$this->setContext($ps_browse_context);\n178\t\t\t}\n179\t\t}\n180\t\t# ------------------------------------------------------\n181\t\t/**\n182\t\t * Dynamically insert facet configuration\n183\t\t *\n184\t\t * @param string $ps_facet_name The name of the facet to insert\n185\t\t * @return bool true if add succeeded\n186\t\t */\n187\t\tpublic function addFacetConfiguration($ps_facet_name, $pa_options) {\n188\t\t\t$this->opa_browse_settings['facets'][$ps_facet_name] = $pa_options;\n189\t\t\t$this->_processBrowseSettings();\n190\t\n191\t\t\treturn true;\n192\t\t}\n193\t\t# ------------------------------------------------------\n194\t\t/**\n195\t\t * Forces reload of the browse instance (ie. a cached browse) from the database\n196\t\t *\n197\t\t * @param int $pn_browse_id The id of the browse to reload\n198\t\t * @return bool true if reload succeeded, false if browse_id was invalid\n199\t\t */\n200\t\tpublic function reload($pn_browse_id) {\n201\t\t\t$this->opo_ca_browse_cache = new BrowseCache();\n202\t\t\t$this->opo_ca_browse_cache->setParameter('table_num', $this->opn_browse_table_num);\n203\t\n204\t\t\treturn (bool)$this->opo_ca_browse_cache->load($pn_browse_id);\n205\t\t}\n206\t\t# ------------------------------------------------------\n207\t\t/**\n208\t\t * Rewrite browse config settings as needed before starting actual processing of browse\n209\t\t */\n210\t\tprivate function _processBrowseSettings() {\n211\t\t\t$va_revised_facets = array();\n212\t\t\t$facet_list = $this->getInfoForFacets();\n213\t\t\tforeach($facet_list as $vs_facet_name => $va_facet_info) {\n214\t\n215\t\t\t\tglobal $g_ui_locale;\n216\t\t\t\tif(is_array($va_facet_info['label_singular'] ?? null)) {\n217\t\t\t\t\tif(isset($va_facet_info['label_singular'][$g_ui_locale])) {\n218\t\t\t\t\t\t$va_facet_info['label_singular'] = $va_facet_info['label_singular'][$g_ui_locale];\n219\t\t\t\t\t}\n220\t\t\t\t}\n221\t\n222\t\t\t\tif(is_array($va_facet_info['label_plural'] ?? null)) {\n223\t\t\t\t\tif(isset($va_facet_info['label_plural'][$g_ui_locale])) {\n224\t\t\t\t\t\t$va_facet_info['label_plural'] = $va_facet_info['label_plural'][$g_ui_locale];\n225\t\t\t\t\t}\n226\t\t\t\t}\n227\t\t\t\t\n228\t\t\t\tif(!isset($va_facet_info['type'])) { $va_facet_info['type'] = null; }\n229\t\t\t\t\n230\t\t\t\t// group_mode = hierarchical is only supported for location facets when current location criteria is storage locations-only\n231\t\t\t\tif ((in_array($va_facet_info['type'], ['location', 'current_value'])) && (caGetOption('group_mode', $va_facet_info, null) == 'hierarchical')) {\n232\t\t\t\t\t$subject_table = $this->ops_browse_table_name;\n233\t\t\t\t\t$policy = caGetOption('policy', $va_facet_info, $subject_table::getDefaultHistoryTrackingCurrentValuePolicyForTable($subject_table));\n234\t\t\t\t\t\n235\t\t\t\t\t$policy_info = $subject_table::getHistoryTrackingCurrentValuePolicy($policy);\n236\t\t\t\t\n237\t\t\t\t\n238\t\t\t\t\tif (is_array($policy_info['elements'])) {\n239\t\t\t\t\t\t$location_elements = [];"}]},"uuid":"07ce0b73-19f7-4990-ba18-4dc513d27dfd","timestamp":"2026-08-19T09:12:21.720Z","sourceToolAssistantUUID":"8819b03a-fb60-4777-af63-f0e07a3c43c0","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/gautier/git/lescollections/meilisearch","sessionId":"8f9b4c71-76ba-45d0-a77c-f69b92544b91","version":"2.1.235","gitBranch":"main"}
