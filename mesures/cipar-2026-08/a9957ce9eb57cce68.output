{"parentUuid":"88af08c7-ba02-4e1d-a92e-9d17da3d5d09","isSidechain":true,"promptId":"275019fc-672f-4da2-ae6a-23a9bfaec64f","agentId":"a9957ce9eb57cce68","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NLPfBk2WR5whKXR3yEaMTD","type":"tool_result","content":"32\t\n33\t/**\n34\t *\n35\t */\n36\t\n37\t\n38\tclass BrowseCache {\n39\t\t# ------------------------------------------------------\n40\t\t/**\n41\t\t * @var Cache key for currently loaded browse\n42\t\t */\n43\t\tprivate $ops_cache_key;\n44\t\n45\t\n46\t\t/**\n47\t\t * @var Working copy of browse data\n48\t\t */\n49\t\tprivate $opa_browse;\n50\t\n51\t\t# ------------------------------------------------------\n52\t\t/**\n53\t\t *\n54\t\t */\n55\t\tpublic function __construct($ps_cache_key=null) {\n56\t\n57\t\t\t$this->opa_browse = array();\n58\t\n59\t\t\tif ($ps_cache_key) {\n60\t\t\t\t$this->load($ps_cache_key);\n61\t\t\t}\n62\t\t}\n63\t\t# ------------------------------------------------------\n64\t\t/**\n65\t\t *\n66\t\t *\n67\t\t * @param string $ps_cache_key\n68\t\t * @param array $pa_options Options include:\n69\t\t *\t\tremoveDeletedItems = remove any items in the cache that are currently marked as deleted [Default=true]\n70\t\t *\n71\t\t * @return bool\n72\t\t */\n73\t\tpublic function load($ps_cache_key, $pa_options=null) {\n74\t\t\tif (ExternalCache::contains($ps_cache_key, 'BrowseFacets') && ExternalCache::contains($ps_cache_key, 'BrowseResults')) {\n75\t\t\t\t$this->opa_browse = [];\n76\t\t\t\t$this->opa_browse['facets'] = ExternalCache::fetch($ps_cache_key, 'BrowseFacets');\n77\t\t\t\t$this->opa_browse['results'] = ExternalCache::fetch($ps_cache_key, 'BrowseResults');\n78\t\t\t\t$this->opa_browse['params'] = ExternalCache::fetch($ps_cache_key, 'BrowseParams');\n79\t\t\t\t$this->opa_browse['type_restrictions'] = ExternalCache::fetch($ps_cache_key, 'BrowseTypeRestrictions');\n80\t\t\t\t$this->opa_browse['source_restrictions'] = ExternalCache::fetch($ps_cache_key, 'BrowseSourceRestrictions');\n81\t\t\t\t\n82\t\t\t\t$this->ops_cache_key = $ps_cache_key;\n83\t\t\t\t\n84\t\t\t\tif (caGetOption('removeDeletedItems', $pa_options, true)) {\n85\t\t\t\t\tif (($t_instance = Datamodel::getInstanceByTableNum($this->opa_browse['params']['table_num'], true)) && ($t_instance->hasField('deleted'))) {\n86\t\t\t\t\t\t// check if there are any deleted items in the cache\n87\t\t\t\t\t\tif (is_array($va_ids = $this->opa_browse['results']) && sizeof($va_ids)) {\n88\t\t\t\t\t\t\t$vs_pk = $t_instance->primaryKey();\n89\t\t\t\t\t\t\t$qr_deleted = $t_instance->getDb()->query($x=\"\n90\t\t\t\t\t\t\t\tSELECT {$vs_pk} FROM \".$t_instance->tableName().\" WHERE {$vs_pk} IN (?) AND deleted = 1\n91\t\t\t\t\t\t\t\", array($va_ids));\t\n92\t\t\t\t\t\t\tif ($qr_deleted->numRows() > 0) {\n93\t\t\t\t\t\t\t\t$va_deleted_ids = $qr_deleted->getAllFieldValues($vs_pk);\n94\t\t\t\t\t\t\t\tforeach($va_deleted_ids as $vn_deleted_id) {\n95\t\t\t\t\t\t\t\t\tif (($vn_i = array_search($vn_deleted_id, $va_ids)) !== false) {\n96\t\t\t\t\t\t\t\t\t\tunset($va_ids[$vn_i]);\n97\t\t\t\t\t\t\t\t\t}\n98\t\t\t\t\t\t\t\t}\n99\t\t\t\t\t\t\t\t$this->opa_browse['results'] = array_values($va_ids);\n100\t\t\t\t\t\t\t}\n101\t\t\t\t\t\t\t\n102\t\t\t\t\t\t}\n103\t\t\t\t\t}\n104\t\t\t\t}\n105\t\t\t\t\n106\t\t\t\treturn true;\n107\t\t\t}\n108\t\n109\t\t\treturn false;\n110\t\t}\n111\t\t# ------------------------------------------------------\n112\t\t/**\n113\t\t *\n114\t\t */\n115\t\tpublic function clear() {\n116\t\t\t$this->opa_browse = array();\n117\t\t\treturn true;\n118\t\t}\n119\t\t# ------------------------------------------------------\n120\t\t/**\n121\t\t *\n122\t\t */\n123\t\tpublic function save() {\n124\t\t\t$this->ops_cache_key = $this->getCurrentCacheKey();\n125\t\t\tExternalCache::save($this->ops_cache_key, $this->opa_browse['facets'] ?? null, 'BrowseFacets');\n126\t\t\tExternalCache::save($this->ops_cache_key, $this->opa_browse['results'] ?? null, 'BrowseResults');\n127\t\t\tExternalCache::save($this->ops_cache_key, $this->opa_browse['params'] ?? null, 'BrowseParams');\n128\t\t\tExternalCache::save($this->ops_cache_key, $this->opa_browse['type_restrictions'] ?? null, 'BrowseTypeRestrictions');\n129\t\t\tExternalCache::save($this->ops_cache_key, $this->opa_browse['source_restrictions'] ?? null, 'BrowseSourceRestrictions');\n130\t\t\treturn true;\n131\t\t}\n132\t\t# ------------------------------------------------------\n133\t\t/**\n134\t\t *\n135\t\t */\n136\t\tpublic function refresh() {\n137\t\t\t$this->ops_cache_key = $this->getCurrentCacheKey();\n138\t\t\treturn $this->load($this->ops_cache_key);\n139\t\t}\n140\t\t# ------------------------------------------------------\n141\t\t/**\n142\t\t *\n143\t\t */\n144\t\tpublic function remove() {\n145\t\t\t$this->opa_browse = array();\n146\t\t\treturn ExternalCache::delete($this->ops_cache_key, 'Browse');\n147\t\t}\n148\t\t# ------------------------------------------------------\n149\t\t/**\n150\t\t *\n151\t\t */\n152\t\tpublic function getCacheKey() {\n153\t\t\t$this->ops_cache_key = $this->getCurrentCacheKey();\n154\t\t\treturn $this->ops_cache_key;\n155\t\t}\n156\t\t# ------------------------------------------------------\n157\t\t/**\n158\t\t *\n159\t\t */\n160\t\tpublic function setFacet($ps_facet_name, &$pa_facet_data) {\n161\t\t\t$this->opa_browse['facets'][$ps_facet_name] = $pa_facet_data;\n162\t\t\treturn true;\n163\t\t}\n164\t\t# ------------------------------------------------------\n165\t\t/**\n166\t\t *\n167\t\t */\n168\t\tpublic function setFacets(&$pa_facet_data) {\n169\t\t\t$this->opa_browse['facets'] = $pa_facet_data;\n170\t\t\treturn true;\n171\t\t}\n172\t\t# ------------------------------------------------------\n173\t\t/**\n174\t\t *\n175\t\t */\n176\t\tpublic function getFacets() {\n177\t\t\treturn $this->opa_browse['facets'] ?? null;\n178\t\t}\n179\t\t# ------------------------------------------------------\n180\t\t/**\n181\t\t *\n182\t\t */\n183\t\tpublic function getFacet($ps_facet_name) {\n184\t\t\treturn (isset($this->opa_browse['facets'][$ps_facet_name]) ? $this->opa_browse['facets'][$ps_facet_name] : null);\n185\t\t}\n186\t\t# ------------------------------------------------------\n187\t\t/**\n188\t\t *\n189\t\t */\n190\t\tpublic function setParameter($ps_param, $pm_value) {\n191\t\t\t$this->opa_browse['params'][$ps_param] = $pm_value;\n192\t\t\treturn $this->ops_cache_key = $this->getCurrentCacheKey();\n193\t\t}\n194\t\t# ------------------------------------------------------\n195\t\t/**\n196\t\t *\n197\t\t */\n198\t\tpublic function getParameters() {\n199\t\t\treturn $this->opa_browse['params'] ?? null;\n200\t\t}\n201\t\t# ------------------------------------------------------\n202\t\t/**\n203\t\t *\n204\t\t */\n205\t\tpublic function getParameter($ps_param) {\n206\t\t\treturn (isset($this->opa_browse['params'][$ps_param]) ? $this->opa_browse['params'][$ps_param] : null);\n207\t\t}\n208\t\t# ------------------------------------------------------\n209\t\t/**\n210\t\t *\n211\t\t */\n212\t\tpublic function setResults($pa_results) {\n213\t\t\t$this->opa_browse['results'] = is_array($pa_results) ? $pa_results : array();\n214\t\t\treturn true;\n215\t\t}\n216\t\t# ------------------------------------------------------\n217\t\t/**\n218\t\t *\n219\t\t */\n220\t\tpublic function numResults() {\n221\t\t\treturn is_array($this->opa_browse['results']) ? sizeof($this->opa_browse['results']) : 0;\n222\t\t}\n223\t\t# ------------------------------------------------------\n224\t\t/**\n225\t\t *\n226\t\t */\n227\t\tpublic function setTypeRestrictions($pa_type_restrictions) {\n228\t\t\t$this->opa_browse['type_restrictions'] = is_array($pa_type_restrictions) ? $pa_type_restrictions : array();\n229\t\t\treturn true;\n230\t\t}\n231\t\t# ------------------------------------------------------\n232\t\t/**\n233\t\t *\n234\t\t */\n235\t\tpublic function getTypeRestrictions() {\n236\t\t\treturn is_array($this->opa_browse['type_restrictions'] ?? null) ? $this->opa_browse['type_restrictions'] : array();\n237\t\t}\n238\t\t# ------------------------------------------------------\n239\t\t/**\n240\t\t *\n241\t\t */\n242\t\tpublic function setSourceRestrictions($pa_source_restrictions) {\n243\t\t\t$this->opa_browse['source_restrictions'] = is_array($pa_source_restrictions) ? $pa_source_restrictions : array();\n244\t\t\treturn true;\n245\t\t}\n246\t\t# ------------------------------------------------------\n247\t\t/**\n248\t\t *\n249\t\t */\n250\t\tpublic function getSourceRestrictions() {\n251\t\t\treturn is_array($this->opa_browse['source_restrictions'] ?? null) ? $this->opa_browse['source_restrictions'] : array();\n252\t\t}\n253\t\t# ------------------------------------------------------\n254\t\t/**\n255\t\t *\n256\t\t */\n257\t\tpublic function getResults() {\n258\t\t\treturn $this->opa_browse['results'] ?? null;\n259\t\t}\n260\t\t# ------------------------------------------------------\n261\t\tpublic function getCurrentCacheKey() {\n262\t\t\tif(!is_array($va_params = $this->getParameters())) { $va_params = array(); }\n263\t\t\tif (!is_array($va_params['criteria'] ?? null)) { $va_params['criteria'] = array(); }\n264\t\t\tif(!is_array($va_type_restrictions = $this->getTypeRestrictions())) { $va_type_restrictions = array(); }\n265\t\t\tif(!is_array($va_source_restrictions = $this->getSourceRestrictions())) { $va_source_restrictions = array(); }\n266\t\n267\t\t\tunset($va_params['created_on']);\n268\t\t\tunset($va_params['context']);\n269\t\t\tunset($va_params['sort']);\n270\t\t\tunset($va_params['sort_direction']);\n271\t\t\tunset($va_params['criteria_display_strings']);\n272\t\t\tunset($va_params['facet_html']);\n273\t\t\tunset($va_params['filterDeaccessionedRecords']);\n274\t\t\tforeach(['criteria'] as $k) {\n275\t\t\t\tif(!is_array($va_params[$k] ?? null)) { $va_params[$k] = []; }\n276\t\t\t}\n277\t\t\tforeach(['table_num'] as $k) {\n278\t\t\t\tif(!isset($va_params[$k])) { $va_params[$k] = null; }\n279\t\t\t}\n280\t\t\treturn BrowseCache::makeCacheKey($va_params, $va_type_restrictions, $va_source_restrictions);\t\n281\t\t}\n282\t\t# ------------------------------------------------------\n283\t\tpublic static function makeCacheKey($pa_params, $pa_type_restrictions, $pa_source_restrictions) {\n284\t\t\tglobal $g_ui_locale;\n285\t\t\tif (!is_array($pa_params['criteria'] ?? null)) { $pa_params['criteria'] = array(); }\n286\t\n287\t\t\treturn md5($g_ui_locale.'/'.print_R($pa_params['context'] ?? '', true).'/'.print_R($pa_params['table_num'] ?? '', true).'/'.print_r(($pa_params['criteria'] ?? null), true).'/'.($pa_params['filterDeaccessionedRecords'] ?? '').'/'.print_r($pa_type_restrictions, true).'/'.print_r($pa_source_restrictions, true));\n288\t\t}\n289\t\t# ------------------------------------------------------\n290\t\t# Global parameters - available to all browses\n291\t\t# ------------------------------------------------------\n292\t\t/**\n293\t\t *\n294\t\t */\n295\t\tpublic function getGlobalParameter($ps_param) {\n296\t\t\tif(ExternalCache::contains(\"browse_global_{$ps_param}\", 'Browse')) {\n297\t\t\t\treturn ExternalCache::fetch(\"browse_global_{$ps_param}\", 'BrowseGlobals');\n298\t\t\t}\n299\t\t\treturn false;\n300\t\t}\n301\t\t# ------------------------------------------------------\n302\t\t/**\n303\t\t *\n304\t\t */\n305\t\tpublic function setGlobalParameter($ps_param, $pm_value) {\n306\t\t\tExternalCache::save(\"browse_global_{$ps_param}\", $pm_value, 'BrowseGlobals');\n307\t\t}\n308\t\t# ------------------------------------------------------\n309\t\t/**\n310\t\t *\n311\t\t */\n312\t\t/*static public function _writeBrowseCacheToDisk() {\n313\t\t\tif (is_array(BrowseCache::$s_data )) {\n314\t\t\t\t$o_cache =  BrowseCache::_getCacheObject();\n315\t\t\t\tforeach(BrowseCache::$s_data as $vs_cache_key => $va_cached_data) {\n316\t\t\t\t\t$o_cache->save($va_cached_data, $vs_cache_key, array('ca_browse_cache'));\n317\t\t\t\t}\n318\t\t\t}\n319\t\t}*/\n320\t\t# -------------------------------